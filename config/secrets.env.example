# Plantilla de secretos de producción — copia a config/secrets.env (o usa
# ./scripts/rotar_secretos.sh, que genera valores fuertes automáticamente).
# config/secrets.env está ignorado por Git.
export SLONE_LICENSE_SECRET="cambia-por-un-secreto-fuerte-compartido-app-y-backend"
export SLONE_WEBHOOK_SECRET="cambia-por-el-secreto-de-tu-pasarela"
export SLONE_ADMIN_TOKEN="cambia-por-un-token-de-admin-largo-y-aleatorio"
