──────\n#  BARRA DE CONTROLES\n# ──────────────────────────────────────────────────────────────\nclass Controls(QWidget):\n    def __init__(self, mpv: MPVWidget, parent=None):\n        super().__init__(parent)\n        self.mpv = mpv; self._playing = False\n        self.setFixedHeight(52)\n        self.setStyleSheet(\"background:#141414;border-top:1px solid #1E1E1E\")\n        lay = QHBoxLayout(self); lay.setContentsMargins(12,5,12,5); lay.setSpacing(6)\n\n        self.btn_pp  = QPushButton(\"▶ Play\"); self.btn_pp.setObjectName(\"C\")\n        self.btn_stp = QPushButton(\"⏹\");     self.btn_stp.setObjectName(\"C\")\n        self.btn_stp.setFixedWidth(42)\n        self.dot = QLabel(\"●\"); self.dot.setStyleSheet(\"color:#444;font-size:20px\")\n        self.lbl = QLabel(\"Sin canal\")\n        self.lbl.setStyleSheet(\"color:#FFB300;font-weight:bold\")\n        self.lbl.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Preferred)\n        lv = QLabel(\"🔊\"); lv.setStyleSheet(\"color:#666\")\n        self.vol = QSlider(Qt.Orientation.Horizontal)\n        self.vol.setRange(0,100); self.vol.setValue(80); self.vol.setFixedWidth(110)\n        self.btn_m = QPushButton(\"🔇\"); self.btn_m.setObjectName(\"C\"); self.btn_m.setFixedWidth(40)\n\n        for w in (self.btn_pp, self.btn_stp, self.dot, self.lbl, lv, self.vol, self.btn_m):\n            lay.addWidget(w)\n\n        self.btn_pp.clicked.connect(self._pp)\n        self.btn_stp.clicked.connect(self._stop)\n        self.vol.valueChanged.connect(lambda v: mpv.set_volume(v))\n        self.btn_m.clicked.connect(self._mute)\n\n        # Actualizar dot periódicamente\n        self._timer = QTimer(self); self._timer.timeout.connect(self._upd_dot)\n        self._timer.start(1000)\n\n    def _pp(self):\n        if self.mpv.is_playing():\n            self.mpv.pause()\n        elif self.mpv._current_url:\n            self.mpv.play(self.mpv._current_url)\n\n    def _stop(self):\n        self.mpv.stop()\n        self.dot.setStyleSheet(\"color:#444;font-size:20px\")\n        self.btn_pp.setText(\"▶ Play\")\n\n    def _mute(self):\n        from PyQt6.QtCore import QObject\n        m = getattr(self, \"_is_muted\", False)\n        m = not m; setattr(self, \"_is_muted\", m)\n        self.mpv.set_mute(m)\n        self.btn_m.setText(\"🔔\" if m else \"🔇\")\n\n    def _upd_dot(self):\n        if self.mpv.is_playing():\n            self.dot.setStyleSheet(\"color:#2ECC71;font-size:20px\")\n            self.btn_pp.setText(\"⏸ Pausa\")\n        else:\n            self.btn_pp.setText(\"▶ Play\")\n\n    def set_channel(self, name: str):\n        self.lbl.setText(f\"📺 {name}\")\n        self.dot.setStyleSheet(\"color:#3498DB;font-size:20px\")\n\n# ──────────────────────────────────────────────────────────────\n#  VENTANA PRINCIPAL\n# ──────────────────────────────────────────────────────────────\nclass SLOCast(QMainWindow):\n    def __init__(self):\n        super().__init__()\n        self.setWindowTitle(\"SLOCast v3.1 — IPTV & Multi-Screen\")\n        self.resize(1300, 800); self.setMinimumSize(900, 600)\n        self.setStyleSheet(DARK)\n        self.channels: list = []; self._loaders: list = []\n\n        self.relay = RelayServer()\n        self._relay_ok = self.relay.start()\n\n        self.mpv = MPVWidget()\n        self._build()\n\n    def _build(self):\n        root = QWidget(); self.setCentralWidget(root)\n        vl = QVBoxLayout(root); vl.setContentsMargins(0,0,0,0); vl.setSpacing(0)\n\n        body = QWidget(); hl = QHBoxLayout(body)\n        hl.setContentsMargins(0,0,0,0); hl.setSpacing(0)\n        hl.addWidget(self._sidebar())\n\n        self.pages = QStackedWidget()\n        self.pages.addWidget(self._p_browser())  # 0\n        self.pages.addWidget(self._p_iptv())      # 1\n        self.pages.addWidget(self._p_files())     # 2\n        self.pages.addWidget(self._p_cast())      # 3\n        hl.addWidget(self.pages, 1); vl.addWidget(body, 1)\n\n        self.ctrl = Controls(self.mpv)\n        vl.addWidget(self.ctrl)\n\n        ip = local_ip(); port = RelayServer.PORT\n        relay_txt = (f\"Relay → http://{ip}:{port}/stream\"\n                     if self._relay_ok else f\"Relay no pudo iniciarse (puerto {port} ocupado)\")\n        self.sb = QLabel(f\"  SLOCast v3.1  |  {relay_txt}\")\n        self.sb.setObjectName(\"SB\"); vl.addWidget(self.sb)\n\n        self.nav.idClicked.connect(self._nav)\n        self.btn_iptv.setChecked(True); self.pages.setCurrentIndex(1)\n\n    def _sidebar(self) -> QWidget:\n        sb = QWidget(); sb.setObjectName(\"Sidebar\")\n        vl = QVBoxLayout(sb); vl.setContentsMargins(0,0,0,0); vl.setSpacing(0)\n        brand = QLabel(\"👑 SLOCast\"); brand.setObjectName(\"Brand\"); vl.addWidget(brand)\n        sep = QFrame(); sep.setFrameShape(QFrame.Shape.HLine)\n        sep.setStyleSheet(\"color:#222\"); vl.addWidget(sep); vl.addSpacing(6)\n\n        self.btn_web   = QPushButton(\"🌐  Navegador Web\")\n        self.btn_iptv  = QPushButton(\"📺  IPTV / M3U\")\n        self.btn_files = QPushButton(\"📁  Archivos Locales\")\n        self.btn_cast  = QPushButton(\"📡  Transmitir a TV\")\n\n        self.nav = QButtonGroup(self); self.nav.setExclusive(True)\n        for i, b in enumerate([self.btn_web, self.btn_iptv, self.btn_files, self.btn_cast]):\n            b.setCheckable(True); vl.addWidget(b); self.nav.addButton(b, i)\n\n        vl.addStretch()\n        rl = QLabel(f\"🔗 Relay :{RelayServer.PORT}  {local_ip()}\")\n        rl.setStyleSheet(\"color:#2ECC71;font-size:11px;padding:8px 14px 14px 14px\")\n        vl.addWidget(rl); return sb\n\n    # ── Páginas ───────────────────────────────────────────────────\n    def _p_browser(self) -> QWidget:\n        w = QWidget(); vl = QVBoxLayout(w)\n        vl.setContentsMargins(0,0,0,0); vl.setSpacing(0)\n        if HAS_WEBENGINE:\n            bar = QWidget(); bar.setStyleSheet(\"background:#141414\")\n            hl  = QHBoxLayout(bar); hl.setContentsMargins(8,5,8,5)\n            self.web_url = QLineEdit()\n            self.web_url.setPlaceholderText(\"Escribe una URL y pulsa Enter…\")\n            self.web_url.returnPressed.connect(self._go)\n            btn = QPushButton(\"Ir\"); btn.setObjectName(\"A\"); btn.setFixedWidth(52)\n            btn.clicked.connect(self._go)\n            hl.addWidget(self.web_url); hl.addWidget(btn); vl.addWidget(bar)\n            self.web = QWebEngineView()\n            self.web.setUrl(QUrl(\"https://duckduckgo.com\")); vl.addWidget(self.web, 1)\n        else:\n            lbl = QLabel(\"WebEngine no disponible.\")\n            lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)\n            vl.addWidget(lbl)\n        return w\n\n    def _p_iptv(self) -> QWidget:\n        w = QWidget(); vl = QVBoxLayout(w)\n        vl.setContentsMargins(10,10,10,6); vl.setSpacing(8)\n\n        top = QHBoxLayout()\n        self.m3u_in = QLineEdit()\n        self.m3u_in.setPlaceholderText(\"URL de lista M3U (http://…) o ruta local (/home/…)\")\n        self.m3u_in.returnPressed.connect(self.load_m3u)\n        btn_f = QPushButton(\"📂\"); btn_f.setObjectName(\"C\"); btn_f.setFixedWidth(42)\n        btn_f.setToolTip(\"Abrir archivo M3U local\"); btn_f.clicked.connect(self._open_m3u)\n        btn_l = QPushButton(\"⬇ Cargar\"); btn_l.setObjectName(\"A\"); btn_l.setFixedWidth(110)\n        btn_l.clicked.connect(self.load_m3u)\n        top.addWidget(self.m3u_in); top.addWidget(btn_f); top.addWidget(btn_l)\n        vl.addLayout(top)\n\n        sb2 = QHBoxLayout()\n        self.srch = QLineEdit(); self.srch.setPlaceholderText(\"🔍 Buscar canal o grupo…\")\n        self.srch.textChanged.connect(self._filter)\n        self.cnt = QLabel(\"0 canales\"); self.cnt.setStyleSheet(\"color:#555;font-size:12px\")\n        sb2.addWidget(self.srch); sb2.addWidget(self.cnt); vl.addLayout(sb2)\n\n        spl = QSplitter(Qt.Orientation.Horizontal)\n        self.ch_list = QListWidget()\n        self.ch_list.itemClicked.connect(self._ch_click)\n        self.ch_list.itemDoubleClicked.connect(self._ch_dbl)\n        spl.addWidget(self.ch_list); spl.addWidget(self.mpv); spl.setSizes([310, 900])\n        vl.addWidget(spl, 1)\n\n        self.prog = QLabel(\"\")\n        self.prog.setStyleSheet(\"color:#555;font-size:12px\")\n        vl.addWidget(self.prog); return w\n\n    def _p_files(self) -> QWidget:\n        w = QWidget(); vl = QVBoxLayout(w)\n        vl.setContentsMargins(24,24,24,24); vl.setSpacing(14)\n        ttl = QLabel(\"📁 Vídeo Local\")\n        ttl.setStyleSheet(\"font-size:18px;font-weight:bold;color:#FFB300\")\n        desc = QLabel(\n            \"Abre un archivo de vídeo local. Se reproducirá en esta app\\n\"\n            \"y el relay lo enviará automáticamente a tu TV.\"\n        )\n        desc.setStyleSheet(\"color:#888;font-size:13px\")\n        btn = QPushButton(\"🎬  Seleccionar archivo de vídeo…\")\n        btn.setObjectName(\"A\"); btn.setFixedWidth(280)\n        btn.clicked.connect(self._open_local)\n        self.lbl_f = QLabel(\"Ningún archivo abierto\")\n        self.lbl_f.setStyleSheet(\"color:#555;font-size:13px\"); self.lbl_f.setWordWrap(True)\n        for w2 in (ttl, desc, btn, self.lbl_f): vl.addWidget(w2)\n        vl.addStretch(); return w\n\n    def _p_cast(self) -> QWidget:\n        w = QWidget(); vl = QVBoxLayout(w)\n        vl.setContentsMargins(28,22,28,22); vl.setSpacing(14)\n\n        ttl = QLabel(\"📡 Transmitir a TV — Relay Multi-Dispositivo\")\n        ttl.setStyleSheet(\"font-size:18px;font-weight:bold;color:#FFB300\")\n        vl.addWidget(ttl)\n\n        box = QWidget(); box.setObjectName(\"RelayBox\")\n        bl  = QVBoxLayout(box); bl.setContentsMargins(18,14,18,14)\n\n        lbl_hdr = QLabel(\"🟢 Servidor relay activo en tu red local\")\n        lbl_hdr.setStyleSheet(\"font-weight:bold;color:#2ECC71;font-size:15px\")\n        bl.addWidget(lbl_hdr)\n\n        lbl_sub = QLabel(\"Introduce esta URL en VLC / MX Player / navegador de tu TV:\")\n        lbl_sub.setStyleSheet(\"color:#aaa;font-size:13px;margin-top:6px\")\n        bl.addWidget(lbl_sub)\n\n        row = QHBoxLayout(); row.setSpacing(10)\n        self.relay_edit = QLineEdit(); self.relay_edit.setObjectName(\"RelayUrl\")\n        self.relay_edit.setReadOnly(True); self.relay_edit.setText(self.relay.stream_url)\n        btn_c = QPushButton(\"📋 Copiar URL\")\n        btn_c.setObjectName(\"G\"); btn_c.setFixedWidth(140); btn_c.clicked.connect(self._copy)\n        row.addWidget(self.relay_edit); row.addWidget(btn_c); bl.addLayout(row)\n        vl.addWidget(box)\n\n        for dev, txt in [\n            (\"📺 Xiaomi TV / Android TV\",\n             \"1. Instala VLC desde Google Play en tu TV\\n\"\n             \"2. VLC → Navegar → Red → pega la URL de arriba → ▶\\n\"\n             \"   Alternativa: MX Player Pro → Abrir URL de red\"),\n            (\"🖥 Smart TV (Samsung / LG / Hisense / Philips)\",\n             \"Navegador integrado del TV → escribe la URL\\n\"\n             \"O cualquier app IPTV de tu TV compatible con HTTP\"),\n            (\"📱 Móvil / Tablet iOS o Android\",\n             \"VLC → Red → pega la URL     o     IPTV Smarters → fuente HTTP\"),\n            (\"💻 Otro PC / Mac con VLC\",\n             \"VLC → Medio → Abrir URL de red → pega → ▶\"),\n        ]:\n            b2 = QWidget()\n            b2.setStyleSheet(\"background:#141414;border-radius:6px;border:1px solid #1E1E1E\")\n            b2l = QVBoxLayout(b2); b2l.setContentsMargins(14,8,14,8)\n            ld = QLabel(dev); ld.setStyleSheet(\"font-weight:bold;color:#FFB300\")\n            lt = QLabel(txt); lt.setStyleSheet(\"color:#bbb;font-size:13px\")\n            b2l.addWidget(ld); b2l.addWidget(lt); vl.addWidget(b2)\n\n        self.lbl_cl = QLabel(\"Dispositivos conectados: 0\")\n        self.lbl_cl.setStyleSheet(\"color:#555;font-size:12px\")\n        vl.addWidget(self.lbl_cl)\n\n        t = QTimer(self); t.timeout.connect(self._upd_cl); t.start(2000)\n        vl.addStretch(); return w\n\n    # ── Slots ─────────────────────────────────────────────────────\n    def _nav(self, idx: int):\n        self.pages.setCurrentIndex(idx)\n        if idx == 3: self.relay_edit.setText(self.relay.stream_url)\n\n    def _go(self):\n        url = self.web_url.text().strip()\n        if not url: return\n        if not url.startswith((\"http://\",\"https://\")): url = \"https://\" + url\n        self.web.setUrl(QUrl(url))\n\n    def load_m3u(self):\n        url = self.m3u_in.text().strip()\n        if not url:\n            QMessageBox.information(self, \"SLOCast\", \"Introduce la URL o ruta de tu lista M3U.\")\n            return\n        self.prog.setText(\"⏳ Iniciando carga…\")\n        loader = M3ULoader(url)\n        loader.progress.connect(lambda m: self.prog.setText(f\"⏳ {m}\"))\n        loader.loaded.connect(self._loaded)\n        loader.failed.connect(self._load_err)\n        loader.start(); self._loaders.append(loader)\n\n    def _open_m3u(self):\n        p, _ = QFileDialog.getOpenFileName(\n            self, \"Abrir lista M3U\", \"\", \"Listas M3U (*.m3u *.m3u8);;Todos (*)\")\n        if p:\n            self.m3u_in.setText(p)\n            self.load_m3u()\n\n    def _loaded(self, chs: list):\n        self.channels = chs; n = len(chs)\n        self.prog.setText(f\"✅ {n} canales cargados\")\n        self.cnt.setText(f\"{n} canales\"); self._populate(chs)\n\n    def _load_err(self, err: str):\n        self.prog.setText(\"❌ Error al cargar\")\n        QMessageBox.warning(self, \"Error M3U\",\n            f\"No se pudo cargar la lista:\\n\\n{err}\\n\\nComprueba la URL o tu conexión.\")\n\n    def _populate(self, chs: list):\n        self.ch_list.clear()\n        for ch in chs:\n            pre  = f\"[{ch['group']}] \" if ch.get(\"group\") else \"\"\n            item = QListWidgetItem(f\"{pre}{ch['name']}\")\n            item.setData(Qt.ItemDataRole.UserRole, ch)\n            if ch.get(\"group\"): item.setToolTip(f\"Grupo: {ch['group']}\")\n            self.ch_list.addItem(item)\n\n    def _filter(self, txt: str):\n        if not txt:\n            self._populate(self.channels)\n            self.cnt.setText(f\"{len(self.channels)} canales\"); return\n        t  = txt.lower()\n        fl = [c for c in self.channels\n              if t in c[\"name\"].lower() or t in c.get(\"group\",\"\").lower()]\n        self._populate(fl); self.cnt.setText(f\"{len(fl)} / {len(self.channels)}\")\n\n    def _ch_click(self, item: QListWidgetItem):\n        ch = item.data(Qt.ItemDataRole.UserRole)\n        if ch: self.ctrl.set_channel(ch[\"name\"])\n\n    def _ch_dbl(self, item: QListWidgetItem):\n        ch = item.data(Qt.ItemDataRole.UserRole)\n        if ch: self._play(ch[\"url\"], ch[\"name\"])\n\n    def _play(self, url: str, name: str = \"\"):\n        # Actualizar relay\n        self.relay.set(url)\n        # Reproducir con MPV directamente (mejor soporte de IPTV)\n        self.pages.setCurrentIndex(1); self.btn_iptv.setChecked(True)\n        self.mpv.play(url)\n        self.ctrl.set_channel(name)\n        self.sb.setText(f\"  ▶ {name}  |  Relay TV: {self.relay.stream_url}\")\n\n    def _open_local(self):\n        p, _ = QFileDialog.getOpenFileName(\n            self, \"Abrir vídeo\", \"\",\n            \"Vídeo (*.mp4 *.mkv *.avi *.mov *.ts *.m4v *.flv *.wmv *.m2ts);;Todos (*)\")\n        if p:\n            self.lbl_f.setText(p)\n            self._play(f\"file://{p}\", Path(p).name)\n\n    def _copy(self):\n        url = self.relay.stream_url\n        QApplication.clipboard().setText(url)\n        QMessageBox.information(self, \"URL copiada\",\n            f\"URL copiada:\\n\\n{url}\\n\\nPégala en VLC o el navegador de tu TV.\")\n\n    def _upd_cl(self):\n        n = RelayHandler.active_clients\n        self.lbl_cl.setText(\n            f\"📱 {n} dispositivo(s) conectado(s) al relay\" if n else \"Dispositivos conectados: 0\")\n\n    def closeEvent(self, event):\n        self.mpv.stop(); self.relay.stop(); super().closeEvent(event)\n\n# ──────────────────────────────────────────────────────────────\nif __name__ == \"__main__\":\n    app = QApplication(sys.argv)\n    app.setApplicationName(\"SLOCast\")\n    win = SLOCast()\n    win.show()\n    sys.exit(app.exec())\nPYEOF\necho \"EXIT:$?\"","Cwd":"/home/slone","WaitMsBeforeAsync":5000,"toolAction":"Writing fixed slocast.py with MPV","toolSummary":"Reescribir app con reproductor MPV"}}]}
