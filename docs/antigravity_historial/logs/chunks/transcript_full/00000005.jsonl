{"step_index":263,"source":"USER_EXPLICIT","type":"USER_INPUT","status":"DONE","created_at":"2026-09-25T18:37:17Z","content":"<USER_REQUEST>\nplanifica como si fueras un ceo de publicidad,planificacion de creacion de multinazionales,experto en diseño,webs,marketing,logos,ventas\nNo more older messages\nConversation Log\ncat << 'EOF' > slo_app.py\n#!/usr/bin/env python3\nimport sys\nfrom pathlib import Path\nfrom urllib.request import urlopen, Request\n\nfrom PyQt6.QtWidgets import (\n    QApplication, QMainWindow, QWidget, QHBoxLayout, QVBoxLayout,\n    QPushButton, QLabel, QStackedWidget, QLineEdit, QListWidget,\n    QSplitter, QMessageBox, QListWidgetItem, QButtonGroup\n)\nfrom PyQt6.QtCore import Qt, QUrl, pyqtSignal, QThread\n\ntry:\n    from PyQt6.QtMultimedia import QMediaPlayer, QAudioOutput\n    from PyQt6.QtMultimediaWidgets import QVideoWidget\n    HAS_MULTIMEDIA = True\nexcept ImportError:\n    HAS_MULTIMEDIA = False\n\ntry:\n    from PyQt6.QtWebEngineWidgets import QWebEngineView\n    HAS_WEBENGINE = True\nexcept ImportError:\n    HAS_WEBENGINE = False\n\nDARK_STYLE = \"\"\"\nQMainWindow, QWidget { background: #121212; color: #E0E0E0; }\n#Sidebar { background: #1E1E1E; border-right: 1px solid #2A2A2A; min-width: 210px; max-width: 230px; }\n#BrandTitle { color: #FFB300; font-size: 18px; font-weight: bold; padding: 15px 10px; }\nQPushButton {\n    color: #E0E0E0; background: transparent; text-align: left;\n    padding: 12px 15px; font-size: 14px; border: none; border-radius: 6px; margin: 2px 8px;\n}\nQPushButton:hover { background: #2C2C2C; color: #FFFFFF; }\nQPushButton:checked { background: #FFB300; color: #121212; font-weight: bold; }\nQLineEdit {\n    background: #2A2A2A; color: #FFFFFF; border: 1px solid #3A3A3A;\n    border-radius: 6px; padding: 8px 12px; font-size: 14px;\n}\nQListWidget { background: #1A1A1A; color: #E0E0E0; border: 1px solid #2A2A2A; border-radius: 6px; }\nQListWidget::item { padding: 10px; border-bottom: 1px solid #262626; }\nQListWidget::item:selected { background: #FFB300; color: #121212; }\n\"\"\"\n\nclass M3ULoader(QThread):\n    loaded = pyqtSignal(list)\n    failed = pyqtSignal(str)\n\n    def __init__(self, source: str):\n        super().__init__()\n        self.source = source\n\n    def run(self):\n        try:\n            if self.source.startswith((\"http://\", \"https://\")):\n                req = Request(self.source, headers={\"User-Agent\": \"Mozilla/5.0\"})\n                with urlopen(req, timeout=15) as resp:\n                    content = resp.read().decode(\"utf-8\", \"ignore\")\n            else:\n                content = Path(self.source).read_text(encoding=\"utf-8\", errors=\"ignore\")\n            \n            channels = []\n            cur_name = \"Canal\"\n            for line in content.splitlines():\n                line = line.strip()\n                if line.startswith(\"#EXTINF:\"):\n                    parts = line.split(\",\", 1)\n                    cur_name = parts[1].strip() if len(parts) > 1 else \"Canal\"\n                elif line and not line.startswith(\"#\"):\n                    channels.append({\"name\": cur_name, \"url\": line})\n                    cur_name = \"Canal\"\n            self.loaded.emit(channels)\n        except Exception as e:\n            self.failed.emit(str(e))\n\nclass SLOWebCastApp(QMainWindow):\n    def __init__(self):\n        super().__init__()\n        self.setWindowTitle(\"SLO Web Cast & IPTV Player v2.0\")\n        self.resize(1150, 720)\n        self.setStyleSheet(DARK_STYLE)\n\n        root = QWidget()\n        self.setCentralWidget(root)\n        layout = QHBoxLayout(root)\n        layout.setContentsMargins(0, 0, 0, 0)\n\n        sidebar = QWidget()\n        sidebar.setObjectName(\"Sidebar\")\n        s_lay = QVBoxLayout(sidebar)\n        brand = QLabel(\" 👑 SLO Web Cast\")\n        brand.setObjectName(\"BrandTitle\")\n        s_lay.addWidget(brand)\n\n        self.btn_nav = QPushButton(\"🌐  Navegador Web\")\n        self.btn_iptv = QPushButton(\"📺  IPTV / M3U\")\n        self.btn_files = QPushButton(\"📁  Archivos Locales\")\n        self.btn_cast = QPushButton(\"📡  Transmitir a TV\")\n        \n        self.group = QButtonGroup(self)\n        self.group.setExclusive(True)\n        \n        btns = [self.btn_nav, self.btn_iptv, self.btn_files, self.btn_cast]\n        for i, b in enumerate(btns):\n            b.setCheckable(True)\n            s_lay.addWidget(b)\n            self.group.addButton(b, i)\n\n        s_lay.addStretch()\n        layout.addWidget(sidebar)\n\n        if HAS_MULTIMEDIA:\n            self.player = QMediaPlayer()\n            self.audio = QAudioOutput()\n            self.player.setAudioOutput(self.audio)\n            self.video_widget = QVideoWidget()\n            self.player.setVideoOutput(self.video_widget)\n        else:\n            self.video_widget = QLabel(\"⚠️ Componente Multimedia no disponible\")\n\n        self.pages = QStackedWidget()\n        self.pages.addWidget(self._create_nav_page())\n        self.pages.addWidget(self._create_iptv_page())\n        self.pages.addWidget(self._create_files_page())\n        self.pages.addWidget(self._create_cast_page())\n        layout.addWidget(self.pages, 1)\n\n        self.group.idClicked.connect(self.pages.setCurrentIndex)\n        self.btn_iptv.setChecked(True)\n        self.pages.setCurrentIndex(1)\n\n    def _create_nav_page(self):\n        w = QWidget()\n        l = QVBoxLayout(w)\n        if HAS_WEBENGINE:\n            web = QWebEngineView()\n            web.setUrl(QUrl(\"https://duckduckgo.com\"))\n            l.addWidget(web)\n        else:\n            l.addWidget(QLabel(\"🌐 Navegador no disponible\"))\n        return w\n\n    def _create_iptv_page(self):\n        w = QWidget()\n        l = QVBoxLayout(w)\n        \n        top = QHBoxLayout()\n        self.m3u_input = QLineEdit()\n        self.m3u_input.setPlaceholderText(\"Pega la URL de tu lista M3U aquí...\")\n        btn = QPushButton(\"Cargar Lista\")\n        btn.setStyleSheet(\"background: #FFB300; color: #121212; font-weight: bold;\")\n        btn.clicked.connect(self.load_m3u)\n        top.addWidget(self.m3u_input)\n        top.addWidget(btn)\n        l.addLayout(top)\n\n        splitter = QSplitter()\n        self.channel_list = QListWidget()\n        self.channel_list.itemDoubleClicked.connect(self.play_selected_channel)\n        \n        splitter.addWidget(self.channel_list)\n        splitter.addWidget(self.video_widget)\n        splitter.setSizes([350, 800])\n        l.addWidget(splitter)\n        return w\n\n    def _create_files_page(self):\n        w = QWidget()\n        l = QVBoxLayout(w)\n        l.addWidget(QLabel(\"📁 Archivos Locales\"))\n        return w\n\n    def _create_cast_page(self):\n        w = QWidget()\n        l = QVBoxLayout(w)\n        l.addWidget(QLabel(\"📡 Transmisión Local (DLNA / Xiaomi TV)\"))\n        return w\n\n    def load_m3u(self):\n        url = self.m3u_input.text().strip()\n        if not url: return\n        self.loader = M3ULoader(url)\n        self.loader.loaded.connect(self.on_m3u_loaded)\n        self.loader.failed.connect(lambda err: QMessageBox.warning(self, \"Error\", f\"Error al cargar: {err}\"))\n        self.loader.start()\n\n    def on_m3u_loaded(self, channels):\n        self.channel_list.clear()\n        for ch in channels:\n            item = QListWidgetItem(ch[\"name\"])\n            item.setData(Qt.ItemDataRole.UserRole, ch[\"url\"])\n            self.channel_list.addItem(item)\n\n    def play_selected_channel(self, item):\n        url = item.data(Qt.ItemDataRole.UserRole)\n        if url and HAS_MULTIMEDIA:\n            self.player.setSource(QUrl(url))\n            self.player.play()\n\nif __name__ == \"__main__\":\n    app = QApplication(sys.argv)\n    win = SLOWebCastApp()\n    win.show()\n    sys.exit(app.exec())\nEOF\npython3 slo_app.py\nhttps://share.gemini.google/PYcc4Z63h3zP\nhttps://mail-attachment.googleusercontent.com/attachment/u/0/