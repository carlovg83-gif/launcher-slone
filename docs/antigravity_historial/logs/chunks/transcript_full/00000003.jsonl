ngineWidgets import QWebEngineView\n    HAS_WEBENGINE = True\nexcept ImportError:\n    HAS_WEBENGINE = False\n\ntry:\n    import pychromecast\n    HAS_CHROMECAST = True\nexcept ImportError:\n    HAS_CHROMECAST = False\n\n# ──────────────────────────────────────────────────────────────\n#  PALETA DE COLORES: AZUL Y AMARILLO FLUORESCENTE\n# ──────────────────────────────────────────────────────────────\nTHEME_STYLE = \"\"\"\nQMainWindow, QWidget {\n    background-color: #080E1A;\n    color: #E6EFFD;\n    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;\n}\n\n/* ── BARRA SUPERIOR WEB VIDEO CASTER ── */\n#TopBar {\n    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0B337A, stop:0.6 #0D47A1, stop:1 #1565C0);\n    border-bottom: 2px solid #D4FF00;\n    min-height: 52px;\n    max-height: 52px;\n}\n#TopBarTitle {\n    color: #FFFFFF;\n    font-size: 16px;\n    font-weight: bold;\n    padding-left: 8px;\n}\n#TopSearchEdit {\n    background: #06152F;\n    color: #FFFFFF;\n    border: 1px solid #1E468A;\n    border-radius: 4px;\n    padding: 6px 12px;\n    font-size: 13px;\n    min-width: 260px;\n}\n#TopSearchEdit:focus {\n    border: 1px solid #D4FF00;\n}\n#TopCastBtn {\n    background: #D4FF00;\n    color: #061124;\n    font-weight: bold;\n    font-size: 13px;\n    padding: 6px 14px;\n    border-radius: 4px;\n    border: none;\n}\n#TopCastBtn:hover {\n    background: #E8FF4D;\n}\n#TopIconBtn {\n    background: transparent;\n    color: #D4FF00;\n    font-size: 18px;\n    padding: 6px 10px;\n    border: none;\n    border-radius: 4px;\n}\n#TopIconBtn:hover {\n    background: rgba(212, 255, 0, 0.15);\n}\n\n/* ── CAJÓN LATERAL (DRAWER) ── */\n#DrawerWidget {\n    background-color: #0A1424;\n    border-right: 1px solid #142848;\n    min-width: 240px;\n    max-width: 250px;\n}\n#DrawerScroll {\n    background: transparent;\n    border: none;\n}\n#DrawerItem {\n    color: #C2D5F2;\n    background: transparent;\n    text-align: left;\n    padding: 11px 18px;\n    font-size: 14px;\n    border: none;\n    border-left: 4px solid transparent;\n    border-radius: 0px;\n    margin: 1px 0px;\n}\n#DrawerItem:hover {\n    background-color: #12233E;\n    color: #FFFFFF;\n}\n#DrawerItem:checked {\n    background-color: #11284A;\n    color: #D4FF00;\n    font-weight: bold;\n    border-left: 4px solid #D4FF00;\n}\n#DrawerSubItem {\n    color: #7E97BA;\n    background: transparent;\n    text-align: left;\n    padding: 8px 18px;\n    font-size: 13px;\n    border: none;\n}\n#DrawerSubItem:hover {\n    color: #D4FF00;\n    background-color: #0E1E36;\n}\n#DrawerSeparator {\n    color: #142848;\n    margin: 8px 14px;\n}\n\n/* ── CONTROLES Y ELEMENTOS DE ENTRADA ── */\nQPushButton#BtnActionPrimary {\n    background: #D4FF00;\n    color: #08101E;\n    font-weight: bold;\n    padding: 9px 18px;\n    border-radius: 5px;\n    border: none;\n    font-size: 13px;\n}\nQPushButton#BtnActionPrimary:hover {\n    background: #EAFF66;\n}\nQPushButton#BtnActionSecondary {\n    background: #0E2A5C;\n    color: #D4FF00;\n    font-weight: bold;\n    border: 1px solid #1E468A;\n    padding: 8px 16px;\n    border-radius: 5px;\n    font-size: 13px;\n}\nQPushButton#BtnActionSecondary:hover {\n    background: #153A7A;\n    border-color: #D4FF00;\n}\nQPushButton#BtnActionRed {\n    background: #991B1B;\n    color: #FFFFFF;\n    font-weight: bold;\n    padding: 8px 16px;\n    border-radius: 5px;\n    border: none;\n}\nQPushButton#BtnActionRed:hover {\n    background: #DC2626;\n}\n\nQLineEdit {\n    background-color: #0B1930;\n    color: #FFFFFF;\n    border: 1px solid #1C3660;\n    border-radius: 5px;\n    padding: 8px 12px;\n    font-size: 13px;\n}\nQLineEdit:focus {\n    border: 1px solid #D4FF00;\n}\n\nQListWidget {\n    background-color: #07101E;\n    color: #D2E1F8;\n    border: 1px solid #132746;\n    border-radius: 6px;\n}\nQListWidget::item {\n    padding: 9px 12px;\n    border-bottom: 1px solid #0F203A;\n}\nQListWidget::item:selected {\n    background-color: #0E3572;\n    color: #D4FF00;\n    font-weight: bold;\n    border-left: 3px solid #D4FF00;\n}\nQListWidget::item:hover {\n    background-color: #0C1E38;\n}\n\n/* ── BARRA INFERIOR DE REPRODUCCIÓN ── */\n#BottomControls {\n    background-color: #071222;\n    border-top: 2px solid #142848;\n    min-height: 54px;\n    max-height: 54px;\n}\nQPushButton#CtlBtn {\n    background: #0E2240;\n    color: #D4FF00;\n    border: 1px solid #183764;\n    border-radius: 4px;\n    padding: 6px 12px;\n    font-weight: bold;\n    font-size: 13px;\n    min-width: 50px;\n}\nQPushButton#CtlBtn:hover {\n    background: #14325C;\n    border-color: #D4FF00;\n}\n\nQSlider::groove:horizontal {\n    height: 4px;\n    background: #132746;\n    border-radius: 2px;\n}\nQSlider::handle:horizontal {\n    background: #D4FF00;\n    width: 14px;\n    height: 14px;\n    margin: -5px 0;\n    border-radius: 7px;\n}\nQSlider::sub-page:horizontal {\n    background: #D4FF00;\n    border-radius: 2px;\n}\n\n#StatusBarLabel {\n    background-color: #050B14;\n    border-top: 1px solid #0E1C30;\n    padding: 4px 14px;\n    color: #6C82A3;\n    font-size: 12px;\n}\n#CardBox {\n    background-color: #0B1930;\n    border: 1px solid #183562;\n    border-radius: 8px;\n    padding: 16px;\n}\n\"\"\"\n\ndef get_local_ip() -> str:\n    try:\n        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)\n        s.connect((\"8.8.8.8\", 80))\n        ip = s.getsockname()[0]\n        s.close()\n        return ip\n    except Exception:\n        return \"127.0.0.1\"\n\nUA_IPTV = \"IPTVSmartersPro\"\n\n# ──────────────────────────────────────────────────────────────\n#  BANNER GEOMÉTRICO (Azul y Amarillo Fluorescente tipo WVC)\n# ──────────────────────────────────────────────────────────────\nclass DrawerGeometricHeader(QWidget):\n    \"\"\"\n    Dibuja los polígonos angulados geométricos de la cabecera\n    de Web Video Caster con tonos Azul Eléctrico y Amarillo Neón.\n    \"\"\"\n    def __init__(self, parent=None):\n        super().__init__(parent)\n        self.setFixedHeight(125)\n\n    def paintEvent(self, event):\n        p = QPainter(self)\n        p.setRenderHint(QPainter.RenderHint.Antialiasing)\n        w, h = self.width(), self.height()\n\n        # Fondo base azul noche profundo\n        p.fillRect(0, 0, w, h, QColor(\"#09172E\"))\n\n        # 1. Polígono superior azul eléctrico primario\n        poly1 = QPolygonF([QPointF(0, 0), QPointF(w, 0), QPointF(w, h * 0.45), QPointF(0, h * 0.70)])\n        grad1 = QLinearGradient(0, 0, w, h * 0.7)\n        grad1.setColorAt(0.0, QColor(\"#0D47A1\"))\n        grad1.setColorAt(1.0, QColor(\"#1976D2\"))\n        p.setPen(Qt.PenStyle.NoPen)\n        p.setBrush(QBrush(grad1))\n        p.drawPolygon(poly1)\n\n        # 2. Polígono facetado azul cian\n        poly2 = QPolygonF([QPointF(0, 0), QPointF(w * 0.75, 0), QPointF(w * 0.40, h * 0.65), QPointF(0, h * 0.45)])\n        p.setBrush(QBrush(QColor(0, 163, 255, 180)))\n        p.drawPolygon(poly2)\n\n        # 3. Triángulo facetado Amarillo Fluorescente (Acento Neón)\n        poly3 = QPolygonF([QPointF(w * 0.15, 0), QPointF(w * 0.60, 0), QPointF(w * 0.38, h * 0.50)])\n        grad_yellow = QLinearGradient(w * 0.15, 0, w * 0.38, h * 0.5)\n        grad_yellow.setColorAt(0.0, QColor(\"#D4FF00\"))\n        grad_yellow.setColorAt(1.0, QColor(\"#B5E600\"))\n        p.setBrush(QBrush(grad_yellow))\n        p.drawPolygon(poly3)\n\n        # 4. Segundo acento amarillo en la esquina angular\n        poly4 = QPolygonF([QPointF(w * 0.28, 0), QPointF(w * 0.48, 0), QPointF(w * 0.38, h * 0.28)])\n        p.setBrush(QBrush(QColor(\"#FFFFFF\")))\n        p.drawPolygon(poly4)\n\n        # Textos de título \"Web Video Caster / SLOCast\"\n        p.setPen(QColor(\"#FFFFFF\"))\n        font_title = QFont(\"Segoe UI\", 13, QFont.Weight.Bold)\n        p.setFont(font_title)\n        p.drawText(16, h - 30, \"Web Video Caster\")\n\n        # Badge de versión en amarillo neón\n        p.setPen(QColor(\"#D4FF00\"))\n        font_ver = QFont(\"Segoe UI\", 9, QFont.Weight.Normal)\n        p.setFont(font_ver)\n        p.drawText(w - 75, h - 30, \"v4.1.0-r620\")\n\n        # Subtítulo\n        p.setPen(QColor(\"#A0C4F5\"))\n        font_sub = QFont(\"Segoe UI\", 8)\n        p.setFont(font_sub)\n        p.drawText(16, h - 14, \"SLOCast Edition · Xiaomi & TV\")\n\n# ──────────────────────────────────────────────────────────────\n#  BROADCAST HUB — MONOCANAL CONTINUO\n# ──────────────────────────────────────────────────────────────\nclass BroadcastHub:\n    def __init__(self):\n        self.lock = threading.Lock()\n        self.current_url: str | None = None\n        self.channel_name: str = \"Sin canal\"\n        self.clients: set[queue.Queue] = set()\n        self.worker_thread: threading.Thread | None = None\n        self.stop_event = threading.Event()\n        self.raw_playlist: str = \"\"\n\n    def register_client(self) -> queue.Queue:\n        q = queue.Queue(maxsize=120)\n        with self.lock:\n            self.clients.add(q)\n        return q\n\n    def unregister_client(self, q: queue.Queue):\n        with self.lock:\n            self.clients.discard(q)\n\n    def set_channel(self, url: str, name: str = \"\"):\n        with self.lock:\n            if self.current_url == url and self.worker_thread and self.worker_thread.is_alive():\n                return\n            self.current_url = url\n            self.channel_name = name or \"Canal IPTV\"\n            self.stop_event.set()\n\n        if self.worker_thread and self.worker_thread.is_alive():\n            self.worker_thread.join(timeout=0.8)\n\n        self.stop_event.clear()\n        self.worker_thread = threading.Thread(target=self._upstream_worker, args=(url,), daemon=True)\n        self.worker_thread.start()\n\n    def _upstream_worker(self, url: str):\n        headers = {\"User-Agent\": UA_IPTV, \"Accept\": \"*/*\", \"Connection\": \"keep-alive\"}\n        backoff = 1.0\n        while not self.stop_event.is_set():\n            try:\n                req = urllib.request.Request(url, headers=headers)\n                with urllib.request.urlopen(req, timeout=12) as resp:\n                    backoff = 1.0\n                    while not self.stop_event.is_set():\n                        chunk = resp.read(32768)\n                        if not chunk:\n                            break\n                        with self.lock:\n                            dead = []\n                            for q in list(self.clients):\n                                try:\n                                    if q.full():\n                                        try: q.get_nowait()\n                                        except Exception: pass\n                                    q.put_nowait(chunk)\n                                except Exception:\n                                    dead.append(q)\n                            for d in dead:\n                                self.clients.discard(d)\n            except Exception:\n                time.sleep(backoff)\n                backoff = min(backoff * 1.5, 5.0)\n\nHUB = BroadcastHub()\n\n# ──────────────────────────────────────────────────────────────\n#  SERVIDOR HTTP RELAY (Puerto 8765)\n# ──────────────────────────────────────────────────────────────\nclass RelayHTTPHandler(BaseHTTPRequestHandler):\n    def do_GET(self):\n        p = self.path\n        if p in (\"/\", \"/status\"):\n            self._serve_status()\n        elif p == \"/stream\":\n            self._serve_stream()\n        elif p == \"/playlist.m3u\":\n            self._serve_playlist()\n        else:\n            self.send_error(404)\n\n    def _serve_status(self):\n        ip = get_local_ip()\n        port = self.server.server_port\n        ch = HUB.channel_name\n        clients = len(HUB.clients)\n        html = f\"\"\"<!DOCTYPE html><html><head><meta charset=\"utf-8\">\n<title>SLOCast Web Video Caster Hub</title>\n<style>\n  body {{ background: #080E1A; color: #E6EFFD; font-family: sans-serif; text-align: center; padding: 30px; }}\n  h1 {{ color: #D4FF00; }}\n  .box {{ background: #0B1930; border: 1px solid #1E468A; border-radius: 8px; max-width: 500px; margin: 20px auto; padding: 20px; }}\n  .url {{ background: #040912; color: #D4FF00; font-family: monospace; font-size: 15px; padding: 10px; border-radius: 5px; border: 1px solid #D4FF00; }}\n</style></head><body>\n<h1>👑 SLOCast Web Video Caster</h1>\n<div class=\"box\">\n  <p>Canal actual: <b>{ch}</b></p>\n  <p>Clientes activos: <b>{clients}</b></p>\n  <div class=\"url\">http://{ip}:{port}/stream</div>\n  <p><a href=\"/stream\" style=\"color:#D4FF00;font-weight:bold;\">▶ Ver Stream</a></p>\n</div></body></html>\"\"\"\n        self.send_response(200)\n        self.send_header(\"Content-Type\", \"text/html; charset=utf-8\")\n        self.end_headers()\n        self.wfile.write(html.encode())\n\n    def _serve_playlist(self):\n        content = HUB.raw_playlist\n        if not content:\n            self.send_error(404)\n            return\n        data = content.encode(\"utf-8\")\n        self.send_response(200)\n        self.send_header(\"Content-Type\", \"application/vnd.apple.mpegurl\")\n        self.send_header(\"Content-Length\", str(len(data)))\n        self.end_headers()\n        self.wfile.write(data)\n\n    def _serve_stream(self):\n        if not HUB.current_url:\n            self.send_error(503, \"Sin canal seleccionado\")\n            return\n        cq = HUB.register_client()\n        try:\n            self.send_response(200)\n            self.send_header(\"Content-Type\", \"video/mp2t\")\n            self.send_header(\"Cache-Control\", \"no-cache\")\n            self.send_header(\"Access-Control-Allow-Origin\", \"*\")\n            self.end_headers()\n            while not HUB.stop_event.is_set():\n                try:\n                    chunk = cq.get(timeout=2.0)\n                    self.wfile.write(chunk)\n                except queue.Empty:\n                    if not (HUB.worker_thread and HUB.worker_thread.is_alive()):\n                        break\n                    continue\n        except (BrokenPipeError, ConnectionResetError):\n            pass\n        finally:\n            HUB.unregister_client(cq)\n\n    def log_message(self, *args): pass\n\n\nclass RelayServer:\n    PORT = 8765\n    def __init__(self):\n        self._srv: ThreadingHTTPServer | None = None\n        self.is_running = False\n\n    def start(self) -> bool:\n        if self.is_running: return True\n        try:\n            self._srv = ThreadingHTTPServer((\"0.0.0.0\", self.PORT), RelayHTTPHandler)\n            threading.Thread(target=self._srv.serve_forever, daemon=True).start()\n            self.is_running = True\n            return True\n        except OSError:\n            return False\n\n    def stop(self):\n        if self._srv:\n            self._srv.shutdown()\n            self.is_running = False\n\n    @property\n    def stream_url(self) -> str:\n        return f\"http://{get_local_ip()}:{self.PORT}/stream\"\n\n    @property\n    def loopback_url(self) -> str:\n        return f\"http://127.0.0.1:{self.PORT}/stream\"\n\n# ──────────────────────────────────────────────────────────────\n#  CONTROLADOR XIAOMI TV (SLÖNE)\n# ──────────────────────────────────────────────────────────────\nclass XiaomiCastController(QThread):\n    cast_status = pyqtSignal(str, bool)\n\n    def __init__(self):\n        super().__init__()\n        self.cast_device = None\n        self.is_connected = False\n        self._target_url = \"\"\n        self._target_title = \"\"\n        self._action = \"idle\"\n\n    def connect_and_play(self, url: str, title: str):\n        self._target_url = url\n        self._target_title = title\n        self._action = \"play\"\n        if not self.isRunning():\n            self.start()\n\n    def stop_cast(self):\n        self._action = \"stop\"\n        if not self.isRunning():\n            self.start()\n\n    def run(self):\n        if not HAS_CHROMECAST:\n            self.cast_status.emit(\"pychromecast no disponible\", False)\n            return\n        try:\n            if self._action == \"play\":\n                self.cast_status.emit(\"Conectando con Xiaomi TV (SLÖNE)...\", False)\n                casts, browser = pychromecast.get_listed_chromecasts(friendly_names=[\"SLÖNE\"])\n                if not casts:\n                    chromecasts, browser = pychromecast.get_chromecasts()\n                    casts = [c for c in chromecasts if \"xiaomi\" in c.model_name.lower() or \"mitv\" in c.model_name.lower()]\n\n                if not casts:\n                    self.cast_status.emit(\"Xiaomi TV no encontrada en la red\", False)\n                    pychromecast.discovery.stop_discovery(browser)\n                    return\n\n                cast = casts[0]\n                cast.wait()\n                mc = cast.media_controller\n                mc.play_media(self._target_url, \"video/mp2t\", title=f\"SLOCast: {self._target_title}\")\n                mc.block_until_active(timeout=5)\n                self.cast_device = cast\n                self.is_connected = True\n                self.cast_status.emit(f\"Transmitiendo en Xiaomi TV: {self._target_title}\", True)\n                pychromecast.discovery.stop_discovery(browser)\n            elif self._action == \"stop\":\n                if self.cast_device:\n                    try: self.cast_device.media_controller.stop()\n                    except Exception: pass\n                self.is_connected = False\n                self.cast_status.emit(\"Transmisión en TV detenida\", False)\n        except Exception as e:\n            self.cast_status.emit(f\"Error Cast: {str(e)[:35]}\", False)\n\n# ──────────────────────────────────────────────────────────────\n#  REPRODUCTOR MPV EMBEBIDO\n# ──────────────────────────────────────────────────────────────\nclass MPVWidget(QWidget):\n    def __init__(self, parent=None):\n        super().__init__(parent)\n        self.setMinimumSize(420, 280)\n        self._proc: QProcess | None = None\n        self._vol = 80\n        self._muted = False\n\n        lay = QVBoxLayout(self)\n        lay.setContentsMargins(0, 0, 0, 0)\n        self.placeholder = QLabel(\"📺  SLOCast Player\\n\\nSelecciona un canal para reproducir\", self)\n        self.placeholder.setAlignment(Qt.AlignmentFlag.AlignCenter)\n        self.placeholder.setStyleSheet(\"color: #4A6B9D; font-size: 15px; font-weight: bold; background: #040912;\")\n        lay.addWidget(self.placeholder)\n\n    def play(self, stream_url: str):\n        self.stop()\n        self.placeholder.hide()\n        wid = str(int(self.winId()))\n        args = [\n            f\"--wid={wid}\",\n            \"--no-terminal\",\n            \"--no-input-default-bindings\",\n            \"--cache=yes\",\n            \"--cache-secs=10\",\n            f\"--volume={self._vol}\",\n            \"--mute=no\" if not self._muted else \"--mute=yes\",\n            f\"--user-agent={UA_IPTV}\",\n            \"--no-sub\",\n            stream_url\n        ]\n        self._proc = QProcess(self)\n        self._proc.finished.connect(lambda: self.placeholder.show())\n        self._proc.start(\"mpv\", args)\n\n    def stop(self):\n        if self._proc:\n            self._proc.write(b\"quit\\n\")\n            self._proc.waitForFinished(300)\n            self._proc.kill()\n            self._proc = None\n        self.placeholder.show()\n\n    def toggle_pause(self):\n        if self._proc and self._proc.state() == QProcess.ProcessState.Running:\n            self._proc.write(b\"cycle pause\\n\")\n\n    def set_volume(self, val: int):\n        self._vol = val\n        if self._proc and self._proc.state() == QProcess.ProcessState.Running:\n            self._proc.write(f\"set volume {val}\\n\".encode())\n\n    def toggle_mute(self):\n        self._muted = not self._muted\n        if self._proc and self._proc.state() == QProcess.ProcessState.Running:\n            self._proc.write(b\"cycle mute\\n\")\n        return self._muted\n\n    def is_playing(self) -> bool:\n        return self._proc is not None and self._proc.state() == QProcess.ProcessState.Running\n\n# ──────────────────────────────────────────────────────────────\n#  CARGADOR ASÍNCRONO M3U\n# ──────────────────────────────────────────────────────────────\nclass M3ULoaderThread(QThread):\n    channels_ready = pyqtSignal(list, str)\n    progress_status = pyqtSignal(str)\n\n    def __init__(self, source: str):\n        super().__init__()\n        self.source = source\n\n    def run(self):\n        try:\n            self.progress_status.emit(\"Leyendo lista M3U...\")\n            content = Path(self.source).read_text(encoding=\"utf-8\", errors=\"ignore\")\n            channels = []\n            cur_name = \"Canal\"\n            cur_group = \"\"\n            for line in content.splitlines():\n                line = line.strip()\n                if line.startswith(\"#EXTINF:\"):\n                    parts = line.split(\",\", 1)\n                    cur_name = parts[1].strip() if len(parts) > 1 else \"Canal\"\n                    cur_group = \"\"\n                    if 'group-title=\"' in line:\n                        try: cur_group = line.split('group-title=\"')[1].split('\"')[0]\n                        except IndexError: pass\n                elif line and not line.startswith(\"#\"):\n                    channels.append({\"name\": cur_name, \"url\": line, \"group\": cur_group})\n                    cur_name = \"Canal\"\n                    cur_group = \"\"\n            self.channels_ready.emit(channels, content)\n        except Exception:\n            pass\n\n# ──────────────────────────────────────────────────────────────\n#  VENTANA PRINCIPAL WEB VIDEO CASTER\n# ──────────────────────────────────────────────────────────────\nclass SLOCastMainWindow(QMainWindow):\n    def __init__(self):\n        super().__init__()\n        self.setWindowTitle(\"SLOCast — Web Video Caster Edition\")\n        self.resize(1300, 800)\n        self.setMinimumSize(960, 620)\n        self.setStyleSheet(THEME_STYLE)\n\n        self.all_channels: list = []\n        self.recent_channels: list = []\n        self.bookmarked_channels: list = []\n        self.current_channel: dict | None = None\n\n        self.relay = RelayServer()\n        self.relay.start()\n\n        self.cast_ctl = XiaomiCastController()\n        self.cast_ctl.cast_status.connect(self._on_cast_status)\n\n        self.mpv = MPVWidget(self)\n\n        self._build_ui()\n        self._check_autoload()\n\n    def _build_ui(self):\n        root = QWidget()\n        self.setCentralWidget(root)\n        vl = QVBoxLayout(root)\n        vl.setContentsMargins(0, 0, 0, 0)\n        vl.setSpacing(0)\n\n        # 1. Barra superior tipo Web Video Caster\n        vl.addWidget(self._build_top_bar())\n\n        # 2. Cuerpo: Menú lateral + Contenedor de páginas\n        body = QWidget()\n        hl = QHBoxLayout(body)\n        hl.setContentsMargins(0, 0, 0, 0)\n        hl.setSpacing(0)\n\n        hl.addWidget(self._build_drawer())\n\n        self.stack = QStackedWidget()\n        self.stack.addWidget(self._page_welcome())      # 0: Browser / Welcome\n        self.stack.addWidget(self._page_iptv())         # 1: IPTV / M3U\n        self.stack.addWidget(self._page_recent())       # 2: Recent videos\n        self.stack.addWidget(self._page_queue())        # 3: Queue\n        self.stack.addWidget(self._page_bookmarks())    # 4: Bookmarks\n        self.stack.addWidget(self._page_backup())       # 5: Backup/Restore\n        self.stack.addWidget(self._page_settings())     # 6: Settings\n        self.stack.addWidget(self._page_server_cast())  # 7: Launch Server Cast\n\n        hl.addWidget(self.stack, 1)\n        vl.addWidget(body, 1)\n\n        # 3. Barra de control inferior\n        vl.addWidget(self._build_bottom_controls())\n\n        # 4. Estado inferior\n        self.status_bar = QLabel(f\"  SLOCast Hub Activo  |  🔗 http://{get_local_ip()}:{RelayServer.PORT}/stream\")\n        self.status_bar.setObjectName(\"StatusBarLabel\")\n        vl.addWidget(self.status_bar)\n\n    # ── BARRA SUPERIOR ─────────────────────────────────────────────\n    def _build_top_bar(self) -> QWidget:\n        tb = QWidget()\n        tb.setObjectName(\"TopBar\")\n        hl = QHBoxLayout(tb)\n        hl.setContentsMargins(12, 0, 16, 0)\n        hl.setSpacing(10)\n\n        # Botón menú hamburguesa\n        btn_menu = QPushButton(\"☰\")\n        btn_menu.setObjectName(\"TopIconBtn\")\n        btn_menu.setFixedWidth(36)\n        btn_menu.setToolTip(\"Alternar menú\")\n\n        title = QLabel(\"Web Video Caster\")\n        title.setObjectName(\"TopBarTitle\")\n\n        self.top_search = QLineEdit()\n        self.top_search.setObjectName(\"TopSearchEdit\")\n        self.top_search.setPlaceholderText(\"🔍  Buscar canales, vídeos o páginas web...\")\n        self.top_search.textChanged.connect(self._on_search_query)\n\n        # Botón Cast a Xiaomi TV en la barra superior\n        self.btn_top_cast = QPushButton(\"📺  Cast a Xiaomi TV (SLÖNE)\")\n        self.btn_top_cast.setObjectName(\"TopCastBtn\")\n        self.btn_top_cast.clicked.connect(self._cast_to_xiaomi_tv)\n\n        btn_screen = QPushButton(\"🖥\")\n        btn_screen.setObjectName(\"TopIconBtn\")\n        btn_screen.setToolTip(\"Modo pantalla completa\")\n        btn_screen.clicked.connect(self._toggle_fullscreen)\n\n        btn_more = QPushButton(\"⋮\")\n        btn_more.setObjectName(\"TopIconBtn\")\n        btn_more.setToolTip(\"Más opciones\")\n        btn_more.clicked.connect(lambda: self.stack.setCurrentIndex(6))\n\n        hl.addWidget(btn_menu)\n        hl.addWidget(title)\n        hl.addStretch()\n        hl.addWidget(self.top_search)\n        hl.addWidget(self.btn_top_cast)\n        hl.addWidget(btn_screen)\n        hl.addWidget(btn_more)\n        return tb\n\n    # ── MENÚ LATERAL (DRAWER) RÉPLICA EXACTA DE LA IMAGEN ──────────\n    def _build_drawer(self) -> QWidget:\n        drawer = QWidget()\n        drawer.setObjectName(\"DrawerWidget\")\n        vl = QVBoxLayout(drawer)\n        vl.setContentsMargins(0, 0, 0, 10)\n        vl.setSpacing(0)\n\n        # Cabecera con banner geométrico Azul y Amarillo Fluorescente\n        vl.addWidget(DrawerGeometricHeader(drawer))\n\n        # Lista de elementos del menú (RÉPLICA EXACTA)\n        self.drawer_group = QButtonGroup(self)\n        self.drawer_group.setExclusive(True)\n\n        items = [\n            (\"🌐  Browser\", 0),\n            (\"📺  IPTV / M3U\", 1),\n            (\"🎬  Recent videos\", 2),\n            (\"▶  Queue\", 3),\n            (\"🔖  Bookmarks\", 4),\n            (\"⏱  Backup/Restore\", 5),\n            (\"⚙  Settings\", 6),\n            (\"🚪  Exit\", -1)\n        ]\n\n        for text, page_idx in items:\n            btn = QPushButton(text)\n            btn.setObjectName(\"DrawerItem\")\n            btn.setCheckable(True)\n            if page_idx == 1:\n                btn.setChecked(True)\n            vl.addWidget(btn)\n            if page_idx >= 0:\n                self.drawer_group.addButton(btn, page_idx)\n            else:\n                btn.clicked.connect(self.close)\n\n        self.drawer_group.idClicked.connect(self.stack.setCurrentIndex)\n\n        # Separador horizontal\n        sep = QFrame()\n        sep.setFrameShape(QFrame.Shape.HLine)\n        sep.setObjectName(\"DrawerSeparator\")\n        vl.addWidget(sep)\n\n        # Enlaces secundarios inferiores de la imagen\n        sub_items = [\n            (\"Launch Server Cast\", lambda: self.stack.setCurrentIndex(7)),\n            (\"FAQ\", self._show_faq),\n            (\"Recommend app\", self._show_recommend),\n            (\"Rate us\", self._show_rate)\n        ]\n\n        for txt, callback in sub_items:\n            b = QPushButton(txt)\n            b.setObjectName(\"DrawerSubItem\")\n            b.clicked.connect(callback)\n            vl.addWidget(b)\n\n        vl.addStretch()\n        return drawer\n\n    # ── PÁGINAS CENTRALES ──────────────────────────────────────────\n\n    def _page_welcome(self) -> QWidget:\n        \"\"\"Página Browser / Welcome con navegador integrado.\"\"\"\n        w = QWidget()\n        vl = QVBoxLayout(w)\n        vl.setContentsMargins(0, 0, 0, 0)\n        vl.setSpacing(0)\n\n        if HAS_WEBENGINE:\n            bar = QWidget()\n            bar.setStyleSheet(\"background: #0B1930; padding: 6px 12px;\")\n            hl = QHBoxLayout(bar)\n            self.txt_url = QLineEdit()\n            self.txt_url.setPlaceholderText(\"Introduce una URL para navegar y transmitir vídeos...\")\n            self.txt_url.setText(\"https://duckduckgo.com\")\n            self.txt_url.returnPressed.connect(self._nav_browser)\n            btn_go = QPushButton(\"Navegar\")\n            btn_go.setObjectName(\"BtnActionPrimary\")\n            btn_go.clicked.connect(self._nav_browser)\n            hl.addWidget(self.txt_url)\n            hl.addWidget(btn_go)\n            vl.addWidget(bar)\n\n            self.web = QWebEngineView()\n            self.web.setUrl(QUrl(\"https://duckduckgo.com\"))\n            vl.addWidget(self.web, 1)\n        else:\n            center_box = QWidget()\n            cv = QVBoxLayout(center_box)\n            cv.setAlignment(Qt.AlignmentFlag.AlignCenter)\n            icon = QLabel(\"📺\")\n            icon.setStyleSheet(\"font-size: 50px;\")\n            title = QLabel(\"Welcome to Web Video Caster\")\n            title.setStyleSheet(\"font-size: 20px; font-weight: bold; color: #FFFFFF;\")\n            sub = QLabel(\"Send videos from this web browser to your streaming devices.\")\n            sub.setStyleSheet(\"color: #7E97BA; font-size: 14px; margin-top: 6px;\")\n            cv.addWidget(icon, 0, Qt.AlignmentFlag.AlignCenter)\n            cv.addWidget(title, 0, Qt.AlignmentFlag.AlignCenter)\n            cv.addWidget(sub, 0, Qt.AlignmentFlag.AlignCenter)\n            vl.addWidget(center_box, 1)\n        return w\n\n    def _page_iptv(self) -> QWidget:\n        \"\"\"Página principal de Canales IPTV.\"\"\"\n        w = QWidget()\n        vl = QVBoxLayout(w)\n        vl.setContentsMargins(14, 14, 14, 8)\n        vl.setSpacing(10)\n\n        # Barra superior con archivo y botones\n        top = QHBoxLayout()\n        self.txt_m3u_file = QLineEdit()\n        self.txt_m3u_file.setPlaceholderText(\"Ruta de la lista M3U (/home/slone/Descargas/TV-76173252_playlist.m3u)...\")\n\n        btn_browse = QPushButton(\"📂 Abrir Archivo\")\n        btn_browse.setObjectName(\"BtnActionSecondary\")\n        btn_browse.clicked.connect(self._browse_m3u)\n\n        btn_load = QPushButton(\"⬇ Cargar\")\n        btn_load.setObjectName(\"BtnActionPrimary\")\n        btn_load.clicked.connect(self._reload_m3u)\n\n        self.lbl_count = QLabel(\"0 canales\")\n        self.lbl_count.setStyleSheet(\"color: #D4FF00; font-weight: bold; padding: 0 8px;\")\n\n        top.addWidget(self.txt_m3u_file)\n        top.addWidget(btn_browse)\n        top.addWidget(btn_load)\n        top.addWidget(self.lbl_count)\n        vl.addLayout(top)\n\n        # Splitter lista de canales y reproductor\n        spl = QSplitter(Qt.Orientation.Horizontal)\n        self.ch_list = QListWidget()\n        self.ch_list.itemClicked.connect(self._on_ch_clicked)\n        self.ch_list.itemDoubleClicked.connect(self._on_ch_double_clicked)\n\n        spl.addWidget(self.ch_list)\n        spl.addWidget(self.mpv)\n        spl.setSizes([340, 920])\n        vl.addWidget(spl, 1)\n\n        self.lbl_iptv_status = QLabel(\"Listo para reproducir\")\n        self.lbl_iptv_status.setStyleSheet(\"color: #7E97BA; font-size: 11px;\")\n        vl.addWidget(self.lbl_iptv_status)\n        return w\n\n    def _page_recent(self) -> QWidget:\n        w = QWidget()\n        vl = QVBoxLayout(w)\n        vl.setContentsMargins(28, 24, 28, 24)\n        ttl = QLabel(\"🎬  Recent videos (Historial de Canales)\")\n        ttl.setStyleSheet(\"font-size: 18px; font-weight: bold; color: #D4FF00;\")\n        vl.addWidget(ttl)\n        self.recent_list = QListWidget()\n        self.recent_list.itemDoubleClicked.connect(self._on_ch_double_clicked)\n        vl.addWidget(self.recent_list, 1)\n        return w\n\n    def _page_queue(self) -> QWidget:\n        w = QWidget()\n        vl = QVBoxLayout(w)\n        vl.setContentsMargins(28, 24, 28, 24)\n        ttl = QLabel(\"▶  Queue (Cola de Reproducción)\")\n        ttl.setStyleSheet(\"font-size: 18px; font-weight: bold; color: #D4FF00;\")\n        vl.addWidget(ttl)\n        self.queue_list = QListWidget()\n        vl.addWidget(self.queue_list, 1)\n        return w\n\n    def _page_bookmarks(self) -> QWidget:\n        w = QWidget()\n        vl = QVBoxLayout(w)\n        vl.setContentsMargins(28, 24, 28, 24)\n        ttl = QLabel(\"🔖  Bookmarks (Canales Favoritos)\")\n        ttl.setStyleSheet(\"font-size: 18px; font-weight: bold; color: #D4FF00;\")\n        vl.addWidget(ttl)\n        self.fav_list = QListWidget()\n        self.fav_list.itemDoubleClicked.connect(self._on_ch_double_clicked)\n        vl.addWidget(self.fav_list, 1)\n        return w\n\n    def _page_backup(self) -> QWidget:\n        w = QWidget()\n        vl = QVBoxLayout(w)\n        vl.setContentsMargins(28, 24, 28, 24)\n        ttl = QLabel(\"⏱  Backup / Restore\")\n        ttl.setStyleSheet(\"font-size: 18px; font-weight: bold; color: #D4FF00;\")\n        desc = QLabel(\"Guarda y recupera tus listas de canales y configuración.\")\n        desc.setStyleSheet(\"color: #7E97BA; margin-bottom: 12px;\")\n        btn_exp = QPushButton(\"Exportar copia de seguridad...\")\n        btn_exp.setObjectName(\"BtnActionSecondary\")\n        btn_exp.setFixedWidth(240)\n        vl.addWidget(ttl)\n        vl.addWidget(desc)\n        vl.addWidget(btn_exp)\n        vl.addStretch()\n        return w\n\n    def _page_settings(self) -> QWidget:\n        w = QWidget()\n        vl = QVBoxLayout(w)\n        vl.setContentsMargins(28, 24, 28, 24)\n        ttl = QLabel(\"⚙  Settings (Ajustes de SLOCast)\")\n        ttl.setStyleSheet(\"font-size: 18px; font-weight: bold; color: #D4FF00;\")\n        vl.addWidget(ttl)\n\n        card = QWidget()\n        card.setObjectName(\"CardBox\")\n        cl = QVBoxLayout(card)\n        cl.addWidget(QLabel(\"<b>Dirección Xiaomi TV:</b> 192.168.1.135 (SLÖNE)\"))\n        cl.addWidget(QLabel(\"<b>Puerto de Emisión Local:</b> 8765\"))\n        cl.addWidget(QLabel(\"<b>Motor Multimedia:</b> MPV con aceleración por hardware\"))\n        cl.addWidget(QLabel(\"<b>Modo Monocanal Anti-Baneo:</b> ACTIVO (1 conexión a Internet)\"))\n        vl.addWidget(card)\n        vl.addStretch()\n        return w\n\n    def _page_server_cast(self) -> QWidget:\n        w = QWidget()\n        vl = QVBoxLayout(w)\n        vl.setContentsMargins(28, 24, 28, 24)\n        ttl = QLabel(\"📡  Launch Server Cast (Servidor de Streaming)\")\n        ttl.setStyleSheet(\"font-size: 18px; font-weight: bold; color: #D4FF00;\")\n        vl.addWidget(ttl)\n\n        box = QWidget()\n        box.setObjectName(\"CardBox\")\n        bl = QVBoxLayout(box)\n        bl.addWidget(QLabel(\"🟢 <b>Servidor Relay Activo en Red Local</b>\"))\n        bl.addWidget(QLabel(\"Comparte este enlace para ver el canal en cualquier televisor o dispositivo móvil:\"))\n\n        hl = QHBoxLayout()\n        self.txt_relay_link = QLineEdit()\n        self.txt_relay_link.setReadOnly(True)\n        self.txt_relay_link.setText(self.relay.stream_url)\n        btn_copy = QPushButton(\"📋 Copiar Enlace\")\n        btn_copy.setObjectName(\"BtnActionPrimary\")\n        btn_copy.clicked.connect(self._copy_link)\n        hl.addWidget(self.txt_relay_link)\n        hl.addWidget(btn_copy)\n        bl.addLayout(hl)\n\n        vl.addWidget(box)\n        vl.addStretch()\n        return w\n\n    # ── CONTROLES INFERIORES ───────────────────────────────────────\n    def _build_bottom_controls(self) -> QWidget:\n        ctl = QWidget()\n        ctl.setObjectName(\"BottomControls\")\n        hl = QHBoxLayout(ctl)\n        hl.setContentsMargins(14, 0, 14, 0)\n        hl.setSpacing(8)\n\n        self.btn_pp = QPushButton(\"▶ Play\")\n        self.btn_pp.setObjectName(\"CtlBtn\")\n        self.btn_pp.clicked.connect(self._toggle_playback)\n\n        self.btn_stop = QPushButton(\"⏹ Stop\")\n        self.btn_stop.setObjectName(\"CtlBtn\")\n        self.btn_stop.clicked.connect(self.mpv.stop)\n\n        self.btn_fav = QPushButton(\"★\")\n        self.btn_fav.setObjectName(\"CtlBtn\")\n        self.btn_fav.setFixedWidth(36)\n        self.btn_fav.setToolTip(\"Guardar en Favoritos\")\n        self.btn_fav.clicked.connect(self._bookmark_current)\n\n        self.lbl_now = QLabel(\"Sin canal seleccionado\")\n        self.lbl_now.setStyleSheet(\"color: #D4FF00; font-weight: bold; font-size: 13px;\")\n        self.lbl_now.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Preferred)\n\n        lbl_v = QLabel(\"🔊\")\n        lbl_v.setStyleSheet(\"color: #D4FF00;\")\n        self.vol_slider = QSlider(Qt.Orientation.Horizontal)\n        self.vol_slider.setRange(0, 100)\n        self.vol_slider.setValue(80)\n        self.vol_slider.setFixedWidth(110)\n        self.vol_slider.valueChanged.connect(self.mpv.set_volume)\n\n        self.btn_mute = QPushButton(\"🔇\")\n        self.btn_mute.setObjectName(\"CtlBtn\")\n        self.btn_mute.setFixedWidth(38)\n        self.btn_mute.clicked.connect(self._toggle_mute)\n\n        self.btn_bottom_cast = QPushButton(\"📺 Enviar a TV\")\n        self.btn_bottom_cast.setObjectName(\"BtnActionPrimary\")\n        self.btn_bottom_cast.clicked.connect(self._cast_to_xiaomi_tv)\n\n        for w in (self.btn_pp, self.btn_stop, self.btn_fav, self.lbl_now,\n                  lbl_v, self.vol_slider, self.btn_mute, self.btn_bottom_cast):\n            hl.addWidget(w)\n\n        self.poll_timer = QTimer(self)\n        self.poll_timer.timeout.connect(self._poll_state)\n        self.poll_timer.start(1000)\n        return ctl\n\n    # ── MÉTODOS Y ACCIONES ─────────────────────────────────────────\n\n    def _check_autoload(self):\n        default_file = Path(\"/home/slone/Descargas/TV-76173252_playlist.m3u\")\n        if default_file.exists():\n            self.txt_m3u_file.setText(str(default_file))\n            self._load_file(str(default_file))\n\n    def _browse_m3u(self):\n        f, _ = QFileDialog.getOpenFileName(\n            self, \"Abrir lista M3U\", str(Path.home() / \"Descargas\"),\n            \"Listas IPTV (*.m3u *.m3u8);;Todos los archivos (*)\"\n        )\n        if f:\n            self.txt_m3u_file.setText(f)\n            self._load_file(f)\n\n    def _reload_m3u(self):\n        src = self.txt_m3u_file.text().strip()\n        if src: self._load_file(src)\n\n    def _load_file(self, path: str):\n        self.lbl_iptv_status.setText(\"⏳ Cargando lista...\")\n        self.loader = M3ULoaderThread(path)\n        self.loader.channels_ready.connect(self._on_channels_loaded)\n        self.loader.start()\n\n    def _on_channels_loaded(self, channels: list, raw: str):\n        self.all_channels = channels\n        HUB.raw_playlist = raw\n        count = len(channels)\n        self.lbl_count.setText(f\"{count} canales\")\n        self.lbl_iptv_status.setText(f\"✅ {count} canales cargados\")\n        self._populate_list(channels[:2000])\n\n    def _populate_list(self, channels: list):\n        self.ch_list.setUpdatesEnabled(False)\n        self.ch_list.clear()\n        for ch in channels:\n            prefix = f\"[{ch['group']}] \" if ch.get(\"group\") else \"\"\n            item = QListWidgetItem(f\"{prefix}{ch['name']}\")\n            item.setData(Qt.ItemDataRole.UserRole, ch)\n            self.ch_list.addItem(item)\n        self.ch_list.setUpdatesEnabled(True)\n\n    def _on_search_query(self, query: str):\n        q = query.strip().lower()\n        if not q:\n            self._populate_list(self.all_channels[:2000])\n            self.lbl_count.setText(f\"{len(self.all_channels)} canales\")\n            return\n        res = [c for c in self.all_channels if q in c[\"name\"].lower() or q in c.get(\"group\", \"\").lower()]\n        self.lbl_count.setText(f\"{len(res)} / {len(self.all_channels)}\")\n        self._populate_list(res[:2000])\n\n    def _on_ch_clicked(self, item: QListWidgetItem):\n        ch = item.data(Qt.ItemDataRole.UserRole)\n        if ch: self.lbl_now.setText(f\"Listo: {ch['name']}\")\n\n    def _on_ch_double_clicked(self, item: QListWidgetItem):\n        ch = item.data(Qt.ItemDataRole.UserRole)\n        if ch: self._tune(ch)\n\n    def _tune(self, ch: dict):\n        self.current_channel = ch\n        name = ch[\"name\"]\n        url = ch[\"url\"]\n\n        HUB.set_channel(url, name)\n        self.mpv.play(self.relay.loopback_url)\n\n        self.lbl_now.setText(f\"📺 {name}\")\n        self.status_bar.setText(f\"  ▶ {name}  |  🔗 Relay TV: {self.relay.stream_url}\")\n\n        if ch not in self.recent_channels:\n            self.recent_channels.insert(0, ch)\n            self._update_recent()\n\n        if self.cast_ctl.is_connected:\n            self.cast_ctl.connect_and_play(self.relay.stream_url, name)\n\n    def _update_recent(self):\n        self.recent_list.clear()\n        for ch in self.recent_channels[:50]:\n            item = QListWidgetItem(f\"🎬 {ch['name']}\")\n            item.setData(Qt.ItemDataRole.UserRole, ch)\n            self.recent_list.addItem(item)\n\n    def _bookmark_current(self):\n        if self.current_channel and self.current_channel not in self.bookmarked_channels:\n            self.bookmarked_channels.append(self.current_channel)\n            item = QListWidgetItem(f\"★ {self.current_channel['name']}\")\n            item.setData(Qt.ItemDataRole.UserRole, self.current_channel)\n            self.fav_list.addItem(item)\n            QMessageBox.information(self, \"Favoritos\", f\"Canal añadido a favoritos:\\n{self.current_channel['name']}\")\n\n    def _cast_to_xiaomi_tv(self):\n        if not HUB.current_url:\n            QMessageBox.information(self, \"Cast TV\", \"Selecciona un canal con doble clic para proyectar en la tele.\")\n            return\n        self.cast_ctl.connect_and_play(self.relay.stream_url, HUB.channel_name)\n\n    def _on_cast_status(self, msg: str, active: bool):\n        self.status_bar.setText(f\"  [XIAOMI TV] {msg}  |  🔗 {self.relay.stream_url}\")\n        if active:\n            self.btn_top_cast.setText(\"📡 Emitiendo en Xiaomi TV\")\n            self.btn_top_cast.setStyleSheet(\"background: #00E676; color: #000; font-weight: bold;\")\n        else:\n            self.btn_top_cast.setText(\"📺 Cast a Xiaomi TV (SLÖNE)\")\n            self.btn_top_cast.setStyleSheet(\"\")\n\n    def _toggle_playback(self):\n        if self.mpv.is_playing():\n            self.mpv.toggle_pause()\n        elif self.current_channel:\n            self._tune(self.current_channel)\n\n    def _toggle_mute(self):\n        m = self.mpv.toggle_mute()\n        self.btn_mute.setText(\"🔔\" if m else \"🔇\")\n\n    def _poll_state(self):\n        if self.mpv.is_playing():\n            self.btn_pp.setText(\"⏸ Pausa\")\n        else:\n            self.btn_pp.setText(\"▶ Play\")\n\n    def _nav_browser(self):\n        if HAS_WEBENGINE:\n            u = self.txt_url.text().strip()\n            if not u.startswith((\"http://\", \"https://\")): u = \"https://\" + u\n            self.web.setUrl(QUrl(u))\n\n    def _copy_link(self):\n        QApplication.clipboard().setText(self.relay.stream_url)\n        QMessageBox.information(self, \"Copiado\", f\"Enlace copiado al portapapeles:\\n\\n{self.relay.stream_url}\")\n\n    def _toggle_fullscreen(self):\n        if self.isFullScreen(): self.showNormal()\n        else: self.showFullScreen()\n\n    def _show_faq(self):\n        QMessageBox.information(\n            self, \"FAQ — Preguntas Frecuentes\",\n            \"<b>¿Cómo ver en la Xiaomi TV?</b><br>\"\n            \"1. Con SLOCast encendido, pulsa el botón amarillo superior <b>Cast a Xiaomi TV</b>.<br>\"\n            \"2. También puedes abrir <b>VLC</b> en la Xiaomi TV e introducir:<br>\"\n            f\"<code>http://{get_local_ip()}:{RelayServer.PORT}/stream</code><br><br>\"\n            \"<b>¿Por qué no se corta la señal?</b><br>\"\n            \"SLOCast abre una sola conexión con el proveedor y la distribuye por WiFi local.\"\n        )\n\n    def _show_recommend(self):\n        QMessageBox.information(self, \"Recomendar\", \"SLOCast Web Video Caster Edition para Fedora 44.\")\n\n    def _show_rate(self):\n        QMessageBox.information(self, \"Valoración\", \"⭐⭐⭐⭐⭐ SLOCast v4.1 configurado para el ThinkPad X390.\")\n\n    def closeEvent(self, event):\n        self.mpv.stop()\n        self.relay.stop()\n        super().closeEvent(event)\n\n# ──────────────────────────────────────────────────────────────\n#  PUNTO DE ARRANQUE\n# ──────────────────────────────────────────────────────────────\nif __name__ == \"__main__\":\n    app = QApplication(sys.argv)\n    app.setApplicationName(\"SLOCast\")\n    win = SLOCastMainWindow()\n    win.show()\n    sys.exit(app.exec())\nPYEOF\necho \"STATUS:$?\"","Cwd":"/home/slone","WaitMsBeforeAsync":5000,"toolAction":"Writing updated Web Video Caster design","toolSummary":"Escribir versión Web Video Caster de SLOCast"}}]}
