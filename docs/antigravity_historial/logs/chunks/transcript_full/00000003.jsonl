e(self):\n        if self._proc and self._proc.state() == QProcess.ProcessState.Running:\n            self._proc.write(b\"cycle pause\\n\")\n\n    def set_volume(self, val: int):\n        self._vol = val\n        if self._proc and self._proc.state() == QProcess.ProcessState.Running:\n            self._proc.write(f\"set volume {val}\\n\".encode())\n\n    def toggle_mute(self):\n        self._muted = not self._muted\n        if self._proc and self._proc.state() == QProcess.ProcessState.Running:\n            self._proc.write(b\"cycle mute\\n\")\n        return self._muted\n\n    def is_playing(self) -> bool:\n        return self._proc is not None and self._proc.state() == QProcess.ProcessState.Running\n\n    def _on_proc_exit(self, code, status):\n        self.placeholder.setText(\"⚠️ Canal desconectado o en espera\")\n        self.placeholder.show()\n\n    def closeEvent(self, event):\n        self.stop()\n        super().closeEvent(event)\n\n# ──────────────────────────────────────────────────────────────\n#  CARGADOR M3U ASÍNCRONO\n# ──────────────────────────────────────────────────────────────\nclass M3ULoaderThread(QThread):\n    channels_ready = pyqtSignal(list, str)\n    failed = pyqtSignal(str)\n    progress_status = pyqtSignal(str)\n\n    def __init__(self, filepath_or_url: str):\n        super().__init__()\n        self.source = filepath_or_url\n\n    def run(self):\n        try:\n            if self.source.startswith((\"http://\", \"https://\")):\n                self.progress_status.emit(\"Descargando lista...\")\n                req = urllib.request.Request(self.source, headers={\"User-Agent\": UA_IPTV})\n                with urllib.request.urlopen(req, timeout=30) as r:\n                    content = r.read().decode(\"utf-8\", \"ignore\")\n            else:\n                self.progress_status.emit(\"Leyendo archivo M3U local...\")\n                content = Path(self.source).read_text(encoding=\"utf-8\", errors=\"ignore\")\n\n            self.progress_status.emit(\"Indexando canales...\")\n            channels = []\n            cur_name = \"Canal\"\n            cur_group = \"\"\n\n            for line in content.splitlines():\n                line = line.strip()\n                if line.startswith(\"#EXTINF:\"):\n                    parts = line.split(\",\", 1)\n                    cur_name = parts[1].strip() if len(parts) > 1 else \"Canal\"\n                    cur_group = \"\"\n                    if 'group-title=\"' in line:\n                        try:\n                            cur_group = line.split('group-title=\"')[1].split('\"')[0]\n                        except IndexError:\n                            pass\n                elif line and not line.startswith(\"#\"):\n                    channels.append({\"name\": cur_name, \"url\": line, \"group\": cur_group})\n                    cur_name = \"Canal\"\n                    cur_group = \"\"\n\n            self.channels_ready.emit(channels, content)\n        except Exception as e:\n            self.failed.emit(str(e))\n\n# ──────────────────────────────────────────────────────────────\n#  VENTANA PRINCIPAL SLOCAST\n# ──────────────────────────────────────────────────────────────\nclass SLOCastMainWindow(QMainWindow):\n    def __init__(self):\n        super().__init__()\n        self.setWindowTitle(\"👑 SLOCast v4.0 — IPTV Hub & Multi-Screen\")\n        self.resize(1340, 820)\n        self.setMinimumSize(960, 620)\n        self.setStyleSheet(DARK_THEME)\n\n        self.all_channels: list = []\n        self.filtered_channels: list = []\n        self.current_channel: dict | None = None\n\n        # Inicializar Relay Server\n        self.relay = RelayServer()\n        self.relay.start()\n\n        # Controlador de Cast a TV\n        self.cast_ctl = XiaomiCastController()\n        self.cast_ctl.cast_status.connect(self._on_cast_status)\n\n        # Reproductor MPV\n        self.mpv = MPVWidget(self)\n\n        self._init_ui()\n        self._check_autoload()\n\n    def _init_ui(self):\n        root = QWidget()\n        self.setCentralWidget(root)\n        main_lay = QVBoxLayout(root)\n        main_lay.setContentsMargins(0, 0, 0, 0)\n        main_lay.setSpacing(0)\n\n        # Centro: Sidebar + Páginas\n        center_widget = QWidget()\n        center_lay = QHBoxLayout(center_widget)\n        center_lay.setContentsMargins(0, 0, 0, 0)\n        center_lay.setSpacing(0)\n\n        center_lay.addWidget(self._build_sidebar())\n\n        self.stack = QStackedWidget()\n        self.stack.addWidget(self._page_iptv())      # 0: IPTV\n        self.stack.addWidget(self._page_cast())      # 1: Cast / Relay\n        self.stack.addWidget(self._page_files())     # 2: Vídeos Locales\n        self.stack.addWidget(self._page_browser())   # 3: Navegador Web\n        center_lay.addWidget(self.stack, 1)\n\n        main_lay.addWidget(center_widget, 1)\n\n        # Barra inferior de controles\n        main_lay.addWidget(self._build_controls())\n\n        # Barra de estado\n        self.status_bar = QLabel(f\"  SLOCast Hub Activo  |  🔗 http://{get_local_ip()}:{RelayServer.PORT}/stream\")\n        self.status_bar.setObjectName(\"StatusBar\")\n        main_lay.addWidget(self.status_bar)\n\n    def _build_sidebar(self) -> QWidget:\n        sb = QWidget()\n        sb.setObjectName(\"Sidebar\")\n        vl = QVBoxLayout(sb)\n        vl.setContentsMargins(0, 0, 0, 0)\n        vl.setSpacing(0)\n\n        brand = QLabel(\"👑 SLOCast\")\n        brand.setObjectName(\"Brand\")\n        vl.addWidget(brand)\n\n        sep = QFrame()\n        sep.setFrameShape(QFrame.Shape.HLine)\n        sep.setStyleSheet(\"color: #222; margin: 4px 10px;\")\n        vl.addWidget(sep)\n\n        self.btn_nav_iptv = QPushButton(\"📺  Canales IPTV\")\n        self.btn_nav_cast = QPushButton(\"📡  Transmitir a TV\")\n        self.btn_nav_files = QPushButton(\"📁  Vídeo Local\")\n        self.btn_nav_web = QPushButton(\"🌐  Navegador Web\")\n\n        self.nav_group = QButtonGroup(self)\n        self.nav_group.setExclusive(True)\n        nav_buttons = [self.btn_nav_iptv, self.btn_nav_cast, self.btn_nav_files, self.btn_nav_web]\n\n        for idx, btn in enumerate(nav_buttons):\n            btn.setCheckable(True)\n            vl.addWidget(btn)\n            self.nav_group.addButton(btn, idx)\n\n        self.btn_nav_iptv.setChecked(True)\n        self.nav_group.idClicked.connect(self._on_tab_change)\n\n        vl.addStretch()\n\n        # Widget info relay\n        lbl_relay = QLabel(f\"● Hub :{RelayServer.PORT}\\nIP: {get_local_ip()}\")\n        lbl_relay.setStyleSheet(\"color: #2ECC71; font-size: 11px; padding: 12px 16px;\")\n        vl.addWidget(lbl_relay)\n        return sb\n\n    def _page_iptv(self) -> QWidget:\n        p = QWidget()\n        vl = QVBoxLayout(p)\n        vl.setContentsMargins(10, 10, 10, 6)\n        vl.setSpacing(8)\n\n        # Barra superior de carga\n        top_bar = QHBoxLayout()\n        self.txt_m3u = QLineEdit()\n        self.txt_m3u.setPlaceholderText(\"Ruta M3U (/home/slone/Descargas/playlist.m3u) o URL...\")\n        self.txt_m3u.returnPressed.connect(self._load_m3u)\n\n        btn_browse = QPushButton(\"📂\")\n        btn_browse.setObjectName(\"BtnCtl\")\n        btn_browse.setFixedWidth(40)\n        btn_browse.clicked.connect(self._browse_m3u)\n\n        btn_load = QPushButton(\"⬇ Cargar\")\n        btn_load.setObjectName(\"BtnGold\")\n        btn_load.setFixedWidth(100)\n        btn_load.clicked.connect(self._load_m3u)\n\n        top_bar.addWidget(self.txt_m3u)\n        top_bar.addWidget(btn_browse)\n        top_bar.addWidget(btn_load)\n        vl.addLayout(top_bar)\n\n        # Barra de búsqueda\n        search_bar = QHBoxLayout()\n        self.txt_search = QLineEdit()\n        self.txt_search.setPlaceholderText(\"🔍  Buscar canal o grupo (ej: DAZN, LaLiga, F1, Deportes)...\")\n        self.txt_search.textChanged.connect(self._on_search_text)\n\n        self.lbl_channel_count = QLabel(\"0 canales\")\n        self.lbl_channel_count.setStyleSheet(\"color: #777; font-size: 12px; min-width: 80px;\")\n\n        search_bar.addWidget(self.txt_search)\n        search_bar.addWidget(self.lbl_channel_count)\n        vl.addLayout(search_bar)\n\n        # Splitter lista | reproductor de vídeo\n        splitter = QSplitter(Qt.Orientation.Horizontal)\n        self.list_channels = QListWidget()\n        self.list_channels.itemDoubleClicked.connect(self._on_channel_double_click)\n        self.list_channels.itemClicked.connect(self._on_channel_click)\n\n        splitter.addWidget(self.list_channels)\n        splitter.addWidget(self.mpv)\n        splitter.setSizes([340, 920])\n        vl.addWidget(splitter, 1)\n\n        self.progress_label = QLabel(\"\")\n        self.progress_label.setStyleSheet(\"color: #FFB300; font-size: 11px;\")\n        vl.addWidget(self.progress_label)\n        return p\n\n    def _page_cast(self) -> QWidget:\n        p = QWidget()\n        vl = QVBoxLayout(p)\n        vl.setContentsMargins(28, 20, 28, 20)\n        vl.setSpacing(14)\n\n        ttl = QLabel(\"📡 Transmisión a Xiaomi TV & Red Local\")\n        ttl.setStyleSheet(\"font-size: 18px; font-weight: bold; color: #FFB300;\")\n        vl.addWidget(ttl)\n\n        # Caja de lanzamiento rápido a Xiaomi TV\n        box_tv = QWidget()\n        box_tv.setStyleSheet(\"background: #141414; border: 2px solid #FFB300; border-radius: 8px;\")\n        tv_lay = QVBoxLayout(box_tv)\n        tv_lay.setContentsMargins(18, 14, 18, 14)\n\n        tv_title = QLabel(\"👑 Transmisión Directa con 1 Clic\")\n        tv_title.setStyleSheet(\"font-size: 15px; font-weight: bold; color: #FFB300;\")\n        tv_desc = QLabel(\"Tu Xiaomi TV (SLÖNE en 192.168.1.135) está detectada en la red local.\\nPuedes proyectar el canal activo directamente sin configurar nada en la tele.\")\n        tv_desc.setStyleSheet(\"color: #AAA; font-size: 13px; margin: 4px 0 10px 0;\")\n\n        btn_row = QHBoxLayout()\n        self.btn_cast_tv = QPushButton(\"📺  Proyectar Canal en Xiaomi TV (SLÖNE)\")\n        self.btn_cast_tv.setObjectName(\"BtnGold\")\n        self.btn_cast_tv.clicked.connect(self._cast_to_xiaomi_tv)\n\n        self.btn_stop_tv = QPushButton(\"⏹  Detener TV\")\n        self.btn_stop_tv.setObjectName(\"BtnRed\")\n        self.btn_stop_tv.setFixedWidth(130)\n        self.btn_stop_tv.clicked.connect(self._stop_xiaomi_tv)\n\n        btn_row.addWidget(self.btn_cast_tv)\n        btn_row.addWidget(self.btn_stop_tv)\n\n        self.lbl_cast_status = QLabel(\"Listo para transmitir\")\n        self.lbl_cast_status.setStyleSheet(\"color: #2ECC71; font-size: 12px; margin-top: 6px;\")\n\n        tv_lay.addWidget(tv_title)\n        tv_lay.addWidget(tv_desc)\n        tv_lay.addLayout(btn_row)\n        tv_lay.addWidget(self.lbl_cast_status)\n        vl.addWidget(box_tv)\n\n        # Caja de Relay URL para otros dispositivos\n        box_relay = QWidget()\n        box_relay.setStyleSheet(\"background: #141414; border: 1px solid #282828; border-radius: 8px;\")\n        r_lay = QVBoxLayout(box_relay)\n        r_lay.setContentsMargins(18, 14, 18, 14)\n\n        r_title = QLabel(\"🔗 Enlace Relay Multi-Dispositivo (VLC / Smart TV / Móvil)\")\n        r_title.setStyleSheet(\"font-size: 14px; font-weight: bold; color: #E0E0E0;\")\n        r_desc = QLabel(\"Introduce esta dirección en VLC de tu TV, tablet o móvil para ver el stream:\")\n        r_desc.setStyleSheet(\"color: #888; font-size: 13px; margin-top: 4px;\")\n\n        row_url = QHBoxLayout()\n        self.txt_relay_url = QLineEdit()\n        self.txt_relay_url.setReadOnly(True)\n        self.txt_relay_url.setStyleSheet(\"background: #081608; color: #2ECC71; font-family: monospace; font-size: 14px; border: 1px solid #27AE60;\")\n        self.txt_relay_url.setText(self.relay.stream_url)\n\n        btn_copy = QPushButton(\"📋 Copiar\")\n        btn_copy.setObjectName(\"BtnGreen\")\n        btn_copy.setFixedWidth(100)\n        btn_copy.clicked.connect(self._copy_relay_url)\n\n        row_url.addWidget(self.txt_relay_url)\n        row_url.addWidget(btn_copy)\n\n        r_lay.addWidget(r_title)\n        r_lay.addWidget(r_desc)\n        r_lay.addLayout(row_url)\n        vl.addWidget(box_relay)\n\n        vl.addStretch()\n        return p\n\n    def _page_files(self) -> QWidget:\n        p = QWidget()\n        vl = QVBoxLayout(p)\n        vl.setContentsMargins(28, 22, 28, 22)\n        vl.setSpacing(14)\n        ttl = QLabel(\"📁 Reproducción de Archivos Locales\")\n        ttl.setStyleSheet(\"font-size: 18px; font-weight: bold; color: #FFB300;\")\n        desc = QLabel(\"Abre cualquier archivo de vídeo descargado (MP4, MKV, TS, AVI).\\nSe reproducirá en la ventana principal de SLOCast y se enviará al Hub Relay para tu TV.\")\n        desc.setStyleSheet(\"color: #888; font-size: 13px;\")\n        btn_file = QPushButton(\"🎬  Seleccionar Archivo de Vídeo...\")\n        btn_file.setObjectName(\"BtnGold\")\n        btn_file.setFixedWidth(270)\n        btn_file.clicked.connect(self._open_local_video)\n\n        self.lbl_open_file = QLabel(\"Ningún archivo abierto actualmente\")\n        self.lbl_open_file.setStyleSheet(\"color: #666; font-size: 13px;\")\n\n        vl.addWidget(ttl)\n        vl.addWidget(desc)\n        vl.addWidget(btn_file)\n        vl.addWidget(self.lbl_open_file)\n        vl.addStretch()\n        return p\n\n    def _page_browser(self) -> QWidget:\n        p = QWidget()\n        vl = QVBoxLayout(p)\n        vl.setContentsMargins(0, 0, 0, 0)\n        vl.setSpacing(0)\n        if HAS_WEBENGINE:\n            bar = QWidget()\n            bar.setStyleSheet(\"background: #141414; padding: 4px 8px;\")\n            hl = QHBoxLayout(bar)\n            self.txt_web = QLineEdit()\n            self.txt_web.setPlaceholderText(\"Dirección web...\")\n            self.txt_web.setText(\"https://duckduckgo.com\")\n            self.txt_web.returnPressed.connect(self._navigate_web)\n            btn_go = QPushButton(\"Ir\")\n            btn_go.setObjectName(\"BtnGold\")\n            btn_go.setFixedWidth(50)\n            btn_go.clicked.connect(self._navigate_web)\n            hl.addWidget(self.txt_web)\n            hl.addWidget(btn_go)\n            vl.addWidget(bar)\n            self.web = QWebEngineView()\n            self.web.setUrl(QUrl(\"https://duckduckgo.com\"))\n            vl.addWidget(self.web, 1)\n        else:\n            vl.addWidget(QLabel(\"Módulo WebEngine no disponible\"), 0, Qt.AlignmentFlag.AlignCenter)\n        return p\n\n    def _build_controls(self) -> QWidget:\n        ctl = QWidget()\n        ctl.setFixedHeight(54)\n        ctl.setStyleSheet(\"background: #141414; border-top: 1px solid #1E1E1E;\")\n        lay = QHBoxLayout(ctl)\n        lay.setContentsMargins(14, 4, 14, 4)\n        lay.setSpacing(8)\n\n        self.btn_play_pause = QPushButton(\"▶ Play\")\n        self.btn_play_pause.setObjectName(\"BtnCtl\")\n        self.btn_play_pause.clicked.connect(self._toggle_playback)\n\n        self.btn_stop = QPushButton(\"⏹ Stop\")\n        self.btn_stop.setObjectName(\"BtnCtl\")\n        self.btn_stop.clicked.connect(self._stop_playback)\n\n        self.dot_status = QLabel(\"●\")\n        self.dot_status.setStyleSheet(\"color: #444; font-size: 20px;\")\n\n        self.lbl_now_playing = QLabel(\"Sin canal activo\")\n        self.lbl_now_playing.setStyleSheet(\"color: #FFB300; font-weight: bold; font-size: 13px;\")\n        self.lbl_now_playing.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Preferred)\n\n        lbl_vol_icon = QLabel(\"🔊\")\n        lbl_vol_icon.setStyleSheet(\"color: #777;\")\n        self.slider_vol = QSlider(Qt.Orientation.Horizontal)\n        self.slider_vol.setRange(0, 100)\n        self.slider_vol.setValue(80)\n        self.slider_vol.setFixedWidth(110)\n        self.slider_vol.valueChanged.connect(self.mpv.set_volume)\n\n        self.btn_mute = QPushButton(\"🔇\")\n        self.btn_mute.setObjectName(\"BtnCtl\")\n        self.btn_mute.setFixedWidth(40)\n        self.btn_mute.clicked.connect(self._toggle_mute)\n\n        self.btn_quick_cast = QPushButton(\"📺 Cast TV\")\n        self.btn_quick_cast.setObjectName(\"BtnGold\")\n        self.btn_quick_cast.setFixedWidth(90)\n        self.btn_quick_cast.clicked.connect(self._cast_to_xiaomi_tv)\n\n        for w in (self.btn_play_pause, self.btn_stop, self.dot_status, self.lbl_now_playing,\n                  lbl_vol_icon, self.slider_vol, self.btn_mute, self.btn_quick_cast):\n            lay.addWidget(w)\n\n        self.poll_timer = QTimer(self)\n        self.poll_timer.timeout.connect(self._poll_ui_state)\n        self.poll_timer.start(1000)\n        return ctl\n\n    # ── Lógica de Canales y Reproducción ──────────────────────────\n\n    def _check_autoload(self):\n        default_path = Path(\"/home/slone/Descargas/TV-76173252_playlist.m3u\")\n        if default_path.exists():\n            self.txt_m3u.setText(str(default_path))\n            self._load_m3u()\n\n    def _browse_m3u(self):\n        path, _ = QFileDialog.getOpenFileName(\n            self, \"Seleccionar lista M3U\", str(Path.home() / \"Descargas\"),\n            \"Listas IPTV (*.m3u *.m3u8);;Todos los archivos (*)\"\n        )\n        if path:\n            self.txt_m3u.setText(path)\n            self._load_m3u()\n\n    def _load_m3u(self):\n        src = self.txt_m3u.text().strip()\n        if not src:\n            return\n        self.progress_label.setText(\"⏳ Cargando lista IPTV...\")\n        self.loader = M3ULoaderThread(src)\n        self.loader.channels_ready.connect(self._on_channels_loaded)\n        self.loader.failed.connect(lambda e: QMessageBox.warning(self, \"Error M3U\", f\"No se pudo cargar:\\n{e}\"))\n        self.loader.progress_status.connect(self.progress_label.setText)\n        self.loader.start()\n\n    def _on_channels_loaded(self, channels: list, raw_content: str):\n        self.all_channels = channels\n        self.filtered_channels = channels\n        HUB.raw_playlist = raw_content\n        count = len(channels)\n        self.progress_label.setText(f\"✅ {count} canales cargados correctamente\")\n        self.lbl_channel_count.setText(f\"{count} canales\")\n        self._render_channel_list(channels[:2000])  # Primer bloque instantáneo\n\n    def _render_channel_list(self, channels: list):\n        self.list_channels.setUpdatesEnabled(False)\n        self.list_channels.clear()\n        for ch in channels:\n            prefix = f\"[{ch['group']}] \" if ch.get(\"group\") else \"\"\n            item = QListWidgetItem(f\"{prefix}{ch['name']}\")\n            item.setData(Qt.ItemDataRole.UserRole, ch)\n            self.list_channels.addItem(item)\n        self.list_channels.setUpdatesEnabled(True)\n\n    def _on_search_text(self, text: str):\n        query = text.strip().lower()\n        if not query:\n            self.filtered_channels = self.all_channels\n            self.lbl_channel_count.setText(f\"{len(self.all_channels)} canales\")\n            self._render_channel_list(self.all_channels[:2000])\n            return\n\n        res = [c for c in self.all_channels if query in c[\"name\"].lower() or query in c.get(\"group\", \"\").lower()]\n        self.filtered_channels = res\n        self.lbl_channel_count.setText(f\"{len(res)} / {len(self.all_channels)}\")\n        self._render_channel_list(res[:2000])\n\n    def _on_channel_click(self, item: QListWidgetItem):\n        ch = item.data(Qt.ItemDataRole.UserRole)\n        if ch:\n            self.lbl_now_playing.setText(f\"Canal listo: {ch['name']}\")\n\n    def _on_channel_double_click(self, item: QListWidgetItem):\n        ch = item.data(Qt.ItemDataRole.UserRole)\n        if ch:\n            self._tune_channel(ch)\n\n    def _tune_channel(self, ch: dict):\n        self.current_channel = ch\n        name = ch[\"name\"]\n        url = ch[\"url\"]\n\n        self.stack.setCurrentIndex(0)\n        self.btn_nav_iptv.setChecked(True)\n\n        # 1. Configurar el Hub Multiplexor (Abre 1 conexión upstream)\n        HUB.set_channel(url, name)\n\n        # 2. Reproducir en PC desde el loopback local\n        self.mpv.play(self.relay.loopback_url)\n\n        self.lbl_now_playing.setText(f\"📺 {name}\")\n        self.dot_status.setStyleSheet(\"color: #3498DB; font-size: 20px;\")\n        self.status_bar.setText(f\"  ▶ {name}  |  🔗 Relay TV: {self.relay.stream_url}\")\n\n        # 3. Si Xiaomi TV estaba emitiendo, proyectar nuevo canal automáticamente\n        if self.cast_ctl.is_connected:\n            self.cast_ctl.connect_and_play(self.relay.stream_url, name)\n\n    def _toggle_playback(self):\n        if self.mpv.is_playing():\n            self.mpv.toggle_pause()\n        elif self.current_channel:\n            self._tune_channel(self.current_channel)\n\n    def _stop_playback(self):\n        self.mpv.stop()\n        self.dot_status.setStyleSheet(\"color: #444; font-size: 20px;\")\n        self.btn_play_pause.setText(\"▶ Play\")\n\n    def _toggle_mute(self):\n        is_muted = self.mpv.toggle_mute()\n        self.btn_mute.setText(\"🔔\" if is_muted else \"🔇\")\n\n    def _poll_ui_state(self):\n        if self.mpv.is_playing():\n            self.dot_status.setStyleSheet(\"color: #2ECC71; font-size: 20px;\")\n            self.btn_play_pause.setText(\"⏸ Pausa\")\n        else:\n            self.btn_play_pause.setText(\"▶ Play\")\n\n    # ── Transmisión y Cast ────────────────────────────────────────\n\n    def _cast_to_xiaomi_tv(self):\n        if not HUB.current_url:\n            QMessageBox.information(self, \"Transmitir\", \"Selecciona primero un canal haciendo doble clic en la lista.\")\n            return\n        self.cast_ctl.connect_and_play(self.relay.stream_url, HUB.channel_name)\n\n    def _stop_xiaomi_tv(self):\n        self.cast_ctl.stop_cast()\n\n    def _on_cast_status(self, msg: str, active: bool):\n        self.lbl_cast_status.setText(msg)\n        self.lbl_cast_status.setStyleSheet(\"color: #2ECC71;\" if active else \"color: #FFB300;\")\n\n    def _copy_relay_url(self):\n        url = self.relay.stream_url\n        QApplication.clipboard().setText(url)\n        QMessageBox.information(self, \"URL Copiada\", f\"Dirección copiada al portapapeles:\\n\\n{url}\\n\\nPégala en VLC en tu televisión.\")\n\n    def _open_local_video(self):\n        path, _ = QFileDialog.getOpenFileName(\n            self, \"Abrir archivo de vídeo\", str(Path.home()),\n            \"Vídeo (*.mp4 *.mkv *.ts *.avi *.mov *.m4v);;Todos los archivos (*)\"\n        )\n        if path:\n            name = Path(path).name\n            self.lbl_open_file.setText(f\"Archivo: {path}\")\n            fake_ch = {\"name\": name, \"url\": f\"file://{path}\", \"group\": \"Archivos Locales\"}\n            self._tune_channel(fake_ch)\n\n    def _navigate_web(self):\n        if HAS_WEBENGINE:\n            url = self.txt_web.text().strip()\n            if not url.startswith((\"http://\", \"https://\")):\n                url = \"https://\" + url\n            self.web.setUrl(QUrl(url))\n\n    def _on_tab_change(self, idx: int):\n        self.stack.setCurrentIndex(idx)\n        if idx == 1:\n            self.txt_relay_url.setText(self.relay.stream_url)\n\n    def closeEvent(self, event):\n        self.mpv.stop()\n        self.relay.stop()\n        super().closeEvent(event)\n\n# ──────────────────────────────────────────────────────────────\n#  PUNTO DE ENTRADA PRINCIPAL\n# ──────────────────────────────────────────────────────────────\nif __name__ == \"__main__\":\n    app = QApplication(sys.argv)\n    app.setApplicationName(\"SLOCast\")\n    win = SLOCastMainWindow()\n    win.show()\n    sys.exit(app.exec())\nPYEOF\necho \"STATUS:$?\"","Cwd":"/home/slone","WaitMsBeforeAsync":5000,"toolAction":"Writing updated SLOCast v4.0 code","toolSummary":"Escribir código completo de SLOCast v4.0"}}]}
