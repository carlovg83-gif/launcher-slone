s_updated.connect(self._on_audio_tracks_detected)\n892: \n893:         # Búsqueda con debounce\n894:         self.search_timer = QTimer(self)\n895:         self.search_timer.setSingleShot(True)\n896:         self.search_timer.timeout.connect(self._execute_search)\n897: \n898:         self._build_ui()\n899:         self._setup_shortcuts()\n900:         self._check_autoload()\n901: \n902:     def _build_ui(self):\n903:         root = QWidget()\n904:         self.setCentralWidget(root)\n905:         vl = QVBoxLayout(root)\n906:         vl.setContentsMargins(0, 0, 0, 0)\n907:         vl.setSpacing(0)\n908: \n909:         # 1. Header superior\n910:         vl.addWidget(self._build_top_header())\n911: \n912:         # 2. Cuerpo: Menú lateral + Stack de páginas\n913:         body = QWidget()\n914:         hl = QHBoxLayout(body)\n915:         hl.setContentsMargins(0, 0, 0, 0)\n916:         hl.setSpacing(0)\n917: \n918:         self.stack = QStackedWidget()\n919:         self.stack.addWidget(self._page_channels())    # 0: Canales IPTV\n920:         self.stack.addWidget(self._page_favorites())   # 1: Favoritos\n921:         self.stack.addWidget(self._page_recents())     # 2: Recientes\n922:         self.stack.addWidget(self._page_remote())      # 3: Mando Web Móvil\n923:         self.stack.addWidget(self._page_cast())        # 4: Transmitir a TV\n924:         self.stack.addWidget(self._page_files())       # 5: Vídeo Local\n925:         self.stack.addWidget(self._page_settings())    # 6: Ajustes Pro\n926: \n927:         hl.addWidget(self._build_sidebar())\n928:         hl.addWidget(self.stack, 1)\n929:         vl.addWidget(body, 1)\n930: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
