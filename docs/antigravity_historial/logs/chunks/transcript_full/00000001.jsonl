f.sld_vol = QSlider(Qt.Orientation.Horizontal)\n        self.sld_vol.setRange(0, 100)\n        self.sld_vol.setValue(80)\n        self.sld_vol.setFixedWidth(110)\n\n        self.btn_mute = QPushButton(\"🔇\")\n        self.btn_mute.setObjectName(\"BtnCtl\")\n        self.btn_mute.setFixedWidth(42)\n        self.btn_mute.setToolTip(\"Silenciar / Activar sonido\")\n\n        for w in (self.btn_play, self.btn_stop, self.lbl_dot,\n                  self.lbl_ch, lbl_vol, self.sld_vol, self.btn_mute):\n            lay.addWidget(w)\n\n        if HAS_MULTIMEDIA and self.audio:\n            self.audio.setVolume(0.8)\n\n    def _connect(self):\n        self.btn_play.clicked.connect(self._toggle_play)\n        self.btn_stop.clicked.connect(self.player.stop)\n        self.btn_mute.clicked.connect(self._toggle_mute)\n        self.sld_vol.valueChanged.connect(\n            lambda v: self.audio.setVolume(v / 100.0) if self.audio else None\n        )\n        self.player.playbackStateChanged.connect(self._on_state)\n        self.player.errorOccurred.connect(self._on_error)\n\n    def _toggle_play(self):\n        ps = QMediaPlayer.PlaybackState\n        if self.player.playbackState() == ps.PlayingState:\n            self.player.pause()\n        else:\n            self.player.play()\n\n    def _toggle_mute(self):\n        self._muted = not self._muted\n        if self.audio:\n            self.audio.setMuted(self._muted)\n        self.btn_mute.setText(\"🔔\" if self._muted else \"🔇\")\n\n    def _on_state(self, state):\n        ps = QMediaPlayer.PlaybackState\n        if state == ps.PlayingState:\n            self.btn_play.setText(\"⏸ Pausa\")\n            self.lbl_dot.setStyleSheet(\"color:#2ECC71; font-size:20px;\")\n        elif state == ps.PausedState:\n            self.btn_play.setText(\"▶ Play\")\n            self.lbl_dot.setStyleSheet(\"color:#FFB300; font-size:20px;\")\n        else:\n            self.btn_play.setText(\"▶ Play\")\n            self.lbl_dot.setStyleSheet(\"color:#444; font-size:20px;\")\n\n    def _on_error(self, _err, msg):\n        self.lbl_dot.setStyleSheet(\"color:#E74C3C; font-size:20px;\")\n        self.lbl_ch.setText(f\"⚠ Error: {msg}\")\n\n    def set_channel(self, name: str):\n        self.lbl_ch.setText(f\"📺 {name}\")\n        self.lbl_dot.setStyleSheet(\"color:#3498DB; font-size:20px;\")\n\n\n# ═══════════════════════════════════════════════════════════════\n# VENTANA PRINCIPAL\n# ═══════════════════════════════════════════════════════════════\n\nclass SLOCastApp(QMainWindow):\n    def __init__(self):\n        super().__init__()\n        self.setWindowTitle(\"👑 SLOCast — IPTV & Multi-Screen v3.0\")\n        self.resize(1300, 800)\n        self.setStyleSheet(DARK_STYLE)\n        self.setMinimumSize(900, 600)\n\n        self.channels: list  = []\n        self._loaders: list  = []   # evitar GC de hilos activos\n\n        # Relay server\n        self.relay = StreamRelayServer()\n        ok = self.relay.start()\n        self._relay_ok = ok\n\n        # Media\n        if HAS_MULTIMEDIA:\n            self.player = QMediaPlayer()\n            self.audio  = QAudioOutput()\n            self.player.setAudioOutput(self.audio)\n            self.video  = QVideoWidget()\n            self.player.setVideoOutput(self.video)\n            self.video.setStyleSheet(\"background:#000;\")\n        else:\n            self.video = QLabel(\n                \"⚠️  Módulo multimedia no disponible.\\n\\n\"\n                \"Instala con:\\n  sudo dnf install python3-pyqt6-qt6-multimedia\"\n            )\n            self.video.setAlignment(Qt.AlignmentFlag.AlignCenter)\n            self.video.setStyleSheet(\"color:#888; font-size:14px;\")\n\n        self._build_ui()\n\n    # ── Construcción de la UI ──────────────────────────────────────\n\n    def _build_ui(self):\n        root = QWidget()\n        self.setCentralWidget(root)\n        vl   = QVBoxLayout(root)\n        vl.setContentsMargins(0, 0, 0, 0)\n        vl.setSpacing(0)\n\n        # Cuerpo\n        body   = QWidget()\n        hl     = QHBoxLayout(body)\n        hl.setContentsMargins(0, 0, 0, 0)\n        hl.setSpacing(0)\n        hl.addWidget(self._build_sidebar())\n\n        self.pages = QStackedWidget()\n        self.pages.addWidget(self._page_browser())   # 0\n        self.pages.addWidget(self._page_iptv())       # 1\n        self.pages.addWidget(self._page_files())      # 2\n        self.pages.addWidget(self._page_cast())       # 3\n        hl.addWidget(self.pages, 1)\n        vl.addWidget(body, 1)\n\n        # Controles\n        if HAS_MULTIMEDIA:\n            self.controls = PlayerControls(self.player, self.audio)\n            vl.addWidget(self.controls)\n\n        # Barra de estado\n        port  = StreamRelayServer.PORT\n        ip    = _local_ip()\n        relay_txt = (f\"🟢 Relay activo → http://{ip}:{port}/stream\"\n                     if self._relay_ok\n                     else f\"🔴 Relay no pudo iniciarse en puerto {port}\")\n        self.sb = QLabel(f\"  SLOCast v3.0  |  {relay_txt}\")\n        self.sb.setObjectName(\"StatusBar\")\n        vl.addWidget(self.sb)\n\n        # Navegación\n        self.nav_group.idClicked.connect(self._on_nav)\n        self.btn_iptv.setChecked(True)\n        self.pages.setCurrentIndex(1)\n\n    def _build_sidebar(self) -> QWidget:\n        sb  = QWidget(); sb.setObjectName(\"Sidebar\")\n        lay = QVBoxLayout(sb)\n        lay.setContentsMargins(0, 0, 0, 0)\n        lay.setSpacing(0)\n\n        brand = QLabel(\"👑 SLOCast\"); brand.setObjectName(\"BrandTitle\")\n        lay.addWidget(brand)\n\n        sep = QFrame(); sep.setFrameShape(QFrame.Shape.HLine)\n        sep.setStyleSheet(\"color:#222;\")\n        lay.addWidget(sep)\n        lay.addSpacing(6)\n\n        self.btn_browser = QPushButton(\"🌐  Navegador Web\")\n        self.btn_iptv    = QPushButton(\"📺  IPTV / M3U\")\n        self.btn_files   = QPushButton(\"📁  Archivos Locales\")\n        self.btn_cast    = QPushButton(\"📡  Transmitir a TV\")\n\n        self.nav_group = QButtonGroup(self)\n        self.nav_group.setExclusive(True)\n        for i, b in enumerate([self.btn_browser, self.btn_iptv,\n                                self.btn_files, self.btn_cast]):\n            b.setCheckable(True)\n            lay.addWidget(b)\n            self.nav_group.addButton(b, i)\n\n        lay.addStretch()\n\n        # Estado relay en sidebar\n        ip   = _local_ip()\n        port = StreamRelayServer.PORT\n        rl   = QLabel(f\"🔗 :{port}  {ip}\")\n        rl.setObjectName(\"RelayStatusLabel\")\n        lay.addWidget(rl)\n        return sb\n\n    # ── Páginas ────────────────────────────────────────────────────\n\n    def _page_browser(self) -> QWidget:\n        w  = QWidget()\n        vl = QVBoxLayout(w)\n        vl.setContentsMargins(0, 0, 0, 0)\n        vl.setSpacing(0)\n\n        if HAS_WEBENGINE:\n            # Barra de URL\n            bar = QWidget()\n            bar.setStyleSheet(\"background:#141414; padding:6px;\")\n            hl  = QHBoxLayout(bar)\n            hl.setContentsMargins(8, 4, 8, 4)\n            self.web_url = QLineEdit()\n            self.web_url.setPlaceholderText(\"Escribe una URL y pulsa Enter…\")\n            self.web_url.returnPressed.connect(self._go_web)\n            btn_go = QPushButton(\"Ir\"); btn_go.setObjectName(\"BtnMain\")\n            btn_go.setFixedWidth(56); btn_go.clicked.connect(self._go_web)\n            hl.addWidget(self.web_url); hl.addWidget(btn_go)\n            vl.addWidget(bar)\n\n            self.web_view = QWebEngineView()\n            self.web_view.setUrl(QUrl(\"https://duckduckgo.com\"))\n            vl.addWidget(self.web_view, 1)\n        else:\n            vl.addWidget(\n                QLabel(\"🌐 WebEngine no disponible.\\n\"\n                       \"Instala: sudo dnf install python3-pyqt6-qt6-webengine\"),\n                0, Qt.AlignmentFlag.AlignCenter\n            )\n        return w\n\n    def _page_iptv(self) -> QWidget:\n        w  = QWidget()\n        vl = QVBoxLayout(w)\n        vl.setContentsMargins(10, 10, 10, 6)\n        vl.setSpacing(8)\n\n        # ── Barra de carga\n        top = QHBoxLayout()\n        self.m3u_input = QLineEdit()\n        self.m3u_input.setPlaceholderText(\n            \"URL de lista M3U (http://...) o ruta local (/home/…/lista.m3u)…\"\n        )\n        self.m3u_input.returnPressed.connect(self.load_m3u)\n\n        btn_file = QPushButton(\"📂\"); btn_file.setObjectName(\"BtnCtl\")\n        btn_file.setFixedWidth(42); btn_file.setToolTip(\"Abrir archivo M3U local\")\n        btn_file.clicked.connect(self._open_m3u_file)\n\n        btn_load = QPushButton(\"⬇ Cargar Lista\"); btn_load.setObjectName(\"BtnMain\")\n        btn_load.setFixedWidth(140); btn_load.clicked.connect(self.load_m3u)\n\n        top.addWidget(self.m3u_input)\n        top.addWidget(btn_file)\n        top.addWidget(btn_load)\n        vl.addLayout(top)\n\n        # ── Barra de búsqueda\n        sbar = QHBoxLayout()\n        self.search = QLineEdit()\n        self.search.setPlaceholderText(\"🔍  Buscar canal o grupo…\")\n        self.search.textChanged.connect(self._filter)\n        self.lbl_count = QLabel(\"0 canales\")\n        self.lbl_count.setStyleSheet(\"color:#555; font-size:12px; min-width:80px;\")\n        sbar.addWidget(self.search)\n        sbar.addWidget(self.lbl_count)\n        vl.addLayout(sbar)\n\n        # ── Splitter lista | vídeo\n        spl = QSplitter(Qt.Orientation.Horizontal)\n        self.ch_list = QListWidget()\n        self.ch_list.itemClicked.connect(self._ch_click)\n        self.ch_list.itemDoubleClicked.connect(self._ch_dbl)\n        spl.addWidget(self.ch_list)\n        spl.addWidget(self.video)\n        spl.setSizes([310, 900])\n        vl.addWidget(spl, 1)\n\n        # ── Progreso\n        self.lbl_prog = QLabel(\"\"); self.lbl_prog.setStyleSheet(\"color:#555; font-size:12px;\")\n        vl.addWidget(self.lbl_prog)\n        return w\n\n    def _page_files(self) -> QWidget:\n        w  = QWidget()\n        vl = QVBoxLayout(w)\n        vl.setContentsMargins(24, 24, 24, 24)\n        vl.setSpacing(14)\n\n        ttl = QLabel(\"📁 Archivos de Vídeo Locales\")\n        ttl.setStyleSheet(\"font-size:18px; font-weight:bold; color:#FFB300;\")\n        vl.addWidget(ttl)\n\n        desc = QLabel(\n            \"Abre cualquier archivo de vídeo local. La reproducción se realizará\\n\"\n            \"en la sección IPTV y el relay la retransmitirá a tu TV automáticamente.\"\n        )\n        desc.setStyleSheet(\"color:#888; font-size:13px;\")\n        vl.addWidget(desc)\n\n        btn = QPushButton(\"🎬  Seleccionar archivo de vídeo…\")\n        btn.setObjectName(\"BtnMain\"); btn.setFixedWidth(280)\n        btn.clicked.connect(self._open_local_file)\n        vl.addWidget(btn)\n\n        self.lbl_file = QLabel(\"Ningún archivo abierto\")\n        self.lbl_file.setStyleSheet(\"color:#555; font-size:13px;\")\n        self.lbl_file.setWordWrap(True)\n        vl.addWidget(self.lbl_file)\n\n        vl.addStretch()\n        return w\n\n    def _page_cast(self) -> QWidget:\n        w  = QWidget()\n        vl = QVBoxLayout(w)\n        vl.setContentsMargins(28, 22, 28, 22)\n        vl.setSpacing(14)\n\n        ttl = QLabel(\"📡  Transmitir a TV — Relay Multi-Dispositivo\")\n        ttl.setStyleSheet(\"font-size:18px; font-weight:bold; color:#FFB300;\")\n        vl.addWidget(ttl)\n\n        # ── Caja relay ────────────────────────────────────────────\n        relay_box = QWidget(); relay_box.setObjectName(\"RelayBox\")\n        rb = QVBoxLayout(relay_box)\n        rb.setContentsMargins(18, 14, 18, 14)\n\n        lbl_hdr = QLabel(\"🟢 Servidor relay activo en tu red local\")\n        lbl_hdr.setStyleSheet(\"font-weight:bold; color:#2ECC71; font-size:15px;\")\n        rb.addWidget(lbl_hdr)\n\n        lbl_sub = QLabel(\"Introduce esta URL en VLC / MX Player / el navegador de tu TV:\")\n        lbl_sub.setStyleSheet(\"color:#aaa; font-size:13px; margin-top:6px;\")\n        rb.addWidget(lbl_sub)\n\n        url_row = QHBoxLayout(); url_row.setSpacing(10)\n        self.relay_url_edit = QLineEdit()\n        self.relay_url_edit.setObjectName(\"RelayUrlEdit\")\n        self.relay_url_edit.setReadOnly(True)\n        self.relay_url_edit.setText(self.relay.stream_url)\n\n        btn_copy = QPushButton(\"📋  Copiar URL\")\n        btn_copy.setObjectName(\"BtnGreen\"); btn_copy.setFixedWidth(140)\n        btn_copy.clicked.connect(self._copy_url)\n        url_row.addWidget(self.relay_url_edit)\n        url_row.addWidget(btn_copy)\n        rb.addLayout(url_row)\n        vl.addWidget(relay_box)\n\n        # ── Instrucciones ─────────────────────────────────────────\n        devices = [\n            (\"📺  Xiaomi TV / Android TV\",\n             \"1. Instala VLC desde Google Play Store en tu TV\\n\"\n             \"2. VLC → Red → Introduce la URL de arriba → ▶ Reproducir\\n\"\n             \"   Alternativa: MX Player → Abre URL de red\"),\n            (\"🖥  Smart TV (Samsung / LG / Hisense / Philips)\",\n             \"1. Abre el Navegador integrado de tu TV\\n\"\n             \"2. Escribe la URL directamente en la barra de direcciones\\n\"\n             \"   O usa la app IPTV de tu TV compatible con HTTP\"),\n            (\"📱  Móvil / Tablet (iOS o Android)\",\n             \"Abre VLC, Infuse, MX Player o IPTV Smarters\\n\"\n             \"y añade la URL como fuente de red\"),\n            (\"💻  Otro ordenador con VLC\",\n             \"VLC → Medio → Abrir URL de red → pega la URL → ▶\"),\n        ]\n\n        for dev, txt in devices:\n            box = QWidget()\n            box.setStyleSheet(\n                \"background:#141414; border-radius:6px; \"\n                \"border: 1px solid #1E1E1E; margin-top:2px;\"\n            )\n            bl = QVBoxLayout(box); bl.setContentsMargins(14, 8, 14, 8)\n            ld = QLabel(dev); ld.setStyleSheet(\"font-weight:bold; color:#FFB300;\")\n            lt = QLabel(txt); lt.setStyleSheet(\"color:#bbb; font-size:13px;\")\n            bl.addWidget(ld); bl.addWidget(lt)\n            vl.addWidget(box)\n\n        self.lbl_clients = QLabel(\"Dispositivos conectados al relay: 0\")\n        self.lbl_clients.setStyleSheet(\"color:#555; font-size:12px;\")\n        vl.addWidget(self.lbl_clients)\n\n        # Actualizar contador de clientes\n        self._cast_timer = QTimer(self)\n        self._cast_timer.timeout.connect(self._update_clients)\n        self._cast_timer.start(2000)\n\n        vl.addStretch()\n        return w\n\n    # ── Slots / métodos ────────────────────────────────────────────\n\n    def _on_nav(self, idx: int):\n        self.pages.setCurrentIndex(idx)\n        if idx == 3:   # Cast\n            self.relay_url_edit.setText(self.relay.stream_url)\n\n    # Navegador web\n    def _go_web(self):\n        url = self.web_url.text().strip()\n        if not url:\n            return\n        if not url.startswith((\"http://\", \"https://\")):\n            url = \"https://\" + url\n        self.web_view.setUrl(QUrl(url))\n\n    # IPTV — carga\n    def load_m3u(self):\n        url = self.m3u_input.text().strip()\n        if not url:\n            QMessageBox.information(self, \"SLOCast\", \"Introduce la URL o ruta de tu lista M3U.\")\n            return\n        self.lbl_prog.setText(\"⏳ Iniciando carga…\")\n        loader = M3ULoader(url)\n        loader.progress.connect(lambda m: self.lbl_prog.setText(f\"⏳ {m}\"))\n        loader.loaded.connect(self._on_loaded)\n        loader.failed.connect(self._on_load_fail)\n        loader.start()\n        self._loaders.append(loader)\n\n    def _open_m3u_file(self):\n        p, _ = QFileDialog.getOpenFileName(\n            self, \"Abrir lista M3U\", \"\",\n            \"Listas M3U (*.m3u *.m3u8);;Todos los archivos (*)\"\n        )\n        if p:\n            self.m3u_input.setText(p)\n            self.load_m3u()\n\n    def _on_loaded(self, channels: list):\n        self.channels = channels\n        n = len(channels)\n        self.lbl_prog.setText(f\"✅ {n} canales cargados\")\n        self.lbl_count.setText(f\"{n} canales\")\n        self._populate(channels)\n\n    def _on_load_fail(self, err: str):\n        self.lbl_prog.setText(f\"❌ Error al cargar\")\n        QMessageBox.warning(\n            self, \"Error al cargar lista M3U\",\n            f\"No se pudo cargar la lista:\\n\\n{err}\\n\\n\"\n            \"Comprueba la URL o tu conexión a Internet.\"\n        )\n\n    def _populate(self, channels: list):\n        self.ch_list.clear()\n        for ch in channels:\n            prefix = f\"[{ch['group']}] \" if ch.get(\"group\") else \"\"\n            item = QListWidgetItem(f\"{prefix}{ch['name']}\")\n            item.setData(Qt.ItemDataRole.UserRole, ch)\n            if ch.get(\"group\"):\n                item.setToolTip(f\"Grupo: {ch['group']}\")\n            self.ch_list.addItem(item)\n\n    def _filter(self, text: str):\n        text = text.lower()\n        if not text:\n            self._populate(self.channels)\n            self.lbl_count.setText(f\"{len(self.channels)} canales\")\n            return\n        filtered = [\n            ch for ch in self.channels\n            if text in ch[\"name\"].lower() or text in ch.get(\"group\", \"\").lower()\n        ]\n        self._populate(filtered)\n        self.lbl_count.setText(f\"{len(filtered)} / {len(self.channels)}\")\n\n    # IPTV — reproducción\n    def _ch_click(self, item: QListWidgetItem):\n        \"\"\"Clic simple: actualiza nombre en la barra de controles.\"\"\"\n        ch = item.data(Qt.ItemDataRole.UserRole)\n        if ch and hasattr(self, \"controls\"):\n            self.controls.set_channel(ch[\"name\"])\n\n    def _ch_dbl(self, item: QListWidgetItem):\n        \"\"\"Doble clic: reproduce el canal.\"\"\"\n        ch = item.data(Qt.ItemDataRole.UserRole)\n        if ch:\n            self._play(ch[\"url\"], ch[\"name\"])\n\n    def _play(self, url: str, name: str = \"\"):\n        if not HAS_MULTIMEDIA:\n            QMessageBox.warning(self, \"Sin multimedia\",\n                                \"El módulo PyQt6.QtMultimedia no está disponible.\")\n            return\n        # Asegurarse de estar en la página IPTV\n        self.pages.setCurrentIndex(1)\n        self.btn_iptv.setChecked(True)\n\n        # Actualizar relay\n        self.relay.set_stream(url)\n\n        # Reproducir\n        self.player.setSource(QUrl(url))\n        self.player.play()\n\n        if hasattr(self, \"controls\"):\n            self.controls.set_channel(name)\n\n        relay_url = self.relay.stream_url\n        self.sb.setText(\n            f\"  ▶ {name}  |  🔗 Relay activo → {relay_url}\"\n        )\n\n    # Archivos locales\n    def _open_local_file(self):\n        p, _ = QFileDialog.getOpenFileName(\n            self, \"Abrir archivo de vídeo\", \"\",\n            \"Vídeo (*.mp4 *.mkv *.avi *.mov *.ts *.m4v *.flv *.wmv *.m2ts);;Todos (*)\"\n        )\n        if p:\n            name = Path(p).name\n            self.lbl_file.setText(f\"📄 {p}\")\n            self._play(f\"file://{p}\", name)\n\n    # Cast\n    def _copy_url(self):\n        url = self.relay.stream_url\n        QApplication.clipboard().setText(url)\n        QMessageBox.information(\n            self, \"URL copiada al portapapeles\",\n            f\"✅ Copiada:\\n\\n{url}\\n\\n\"\n            \"Pégala en VLC, MX Player o el navegador de tu Xiaomi TV.\"\n        )\n\n    def _update_clients(self):\n        n = RelayHandler.active_clients\n        txt = (f\"📱 {n} dispositivo(s) conectado(s) al relay\" if n > 0\n               else \"Dispositivos conectados al relay: 0\")\n        self.lbl_clients.setText(txt)\n\n    def closeEvent(self, event):\n        self.relay.stop()\n        super().closeEvent(event)\n\n\n# ═══════════════════════════════════════════════════════════════\n# ENTRADA PRINCIPAL\n# ═══════════════════════════════════════════════════════════════\n\nif __name__ == \"__main__\":\n    app = QApplication(sys.argv)\n    app.setApplicationName(\"SLOCast\")\n    win = SLOCastApp()\n    win.show()\n    sys.exit(app.exec())\n","Description":"Aplicación completa SLOCast v3.0 con reproductor IPTV y servidor relay HTTP multi-dispositivo.","Overwrite":false,"TargetFile":"/home/slone/.gemini/antigravity/scratch/slocast/slocast.py","toolAction":"Creating SLOCast main application","toolSummary":"Crear slocast.py completo"}}]}
