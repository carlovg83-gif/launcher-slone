border:2px solid #27AE60;border-radius:8px}\nQLineEdit#RelayUrl{background:#071407;color:#2ECC71;font-family:monospace;font-size:14px;\n  border:1px solid #27AE60;border-radius:4px;padding:9px 12px}\nQPushButton{color:#E0E0E0;background:transparent;text-align:left;padding:11px 16px;\n  font-size:14px;border:none;border-radius:6px;margin:2px 8px}\nQPushButton:hover{background:#222;color:#FFF}\nQPushButton:checked{background:#FFB300;color:#121212;font-weight:bold}\nQPushButton#A{background:#FFB300;color:#121212;font-weight:bold;text-align:center;\n  padding:10px 20px;border-radius:6px;margin:0}\nQPushButton#A:hover{background:#FFC933}\nQPushButton#A:disabled{background:#333;color:#666}\nQPushButton#C{background:#1E1E1E;color:#E0E0E0;text-align:center;padding:7px 12px;\n  border-radius:5px;margin:0 3px;min-width:72px}\nQPushButton#C:hover{background:#2A2A2A}\nQPushButton#G{background:#27AE60;color:#FFF;font-weight:bold;text-align:center;\n  padding:10px 20px;border-radius:6px;margin:0}\nQPushButton#G:hover{background:#2ECC71}\nQLineEdit{background:#191919;color:#FFF;border:1px solid #333;border-radius:6px;\n  padding:8px 12px;font-size:14px}\nQLineEdit:focus{border-color:#FFB300}\nQListWidget{background:#111;color:#E0E0E0;border:1px solid #222;border-radius:6px}\nQListWidget::item{padding:8px 12px;border-bottom:1px solid #191919}\nQListWidget::item:selected{background:#FFB300;color:#121212}\nQListWidget::item:hover{background:#1E1E1E}\nQSlider::groove:horizontal{height:4px;background:#2A2A2A;border-radius:2px}\nQSlider::handle:horizontal{background:#FFB300;width:14px;height:14px;margin:-5px 0;border-radius:7px}\nQSlider::sub-page:horizontal{background:#FFB300;border-radius:2px}\nQSplitter::handle{background:#1A1A1A}\n\"\"\"\n\n# ──────────────────────────────────────────────────────────────\n#  UTILIDADES DE RED\n# ──────────────────────────────────────────────────────────────\ndef local_ip() -> str:\n    try:\n        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)\n        s.connect((\"8.8.8.8\", 80))\n        ip = s.getsockname()[0]; s.close(); return ip\n    except Exception:\n        return \"127.0.0.1\"\n\nUA = \"Mozilla/5.0 (Linux; Android 11) AppleWebKit/537.36 VLC/3.0\"\n\n# ──────────────────────────────────────────────────────────────\n#  SERVIDOR DE RELAY HTTP (puerto 8765)\n# ──────────────────────────────────────────────────────────────\nclass RelayHandler(BaseHTTPRequestHandler):\n    current_url: str = None\n    active_clients: int = 0\n    _lock = threading.Lock()\n\n    def do_GET(self):\n        p = self.path\n        if p in (\"/\", \"/status\"):\n            self._status()\n        elif p == \"/stream\":\n            url = RelayHandler.current_url\n            if url: self._proxy(url)\n            else: self.send_error(503, \"Sin canal activo\")\n        elif p.startswith(\"/proxy?\"):\n            raw = urllib.parse.parse_qs(p[7:])\n            target = urllib.parse.unquote(raw.get(\"url\", [\"\"])[0])\n            if target: self._proxy(target)\n            else: self.send_error(400, \"url requerida\")\n        else:\n            self.send_error(404)\n\n    def _status(self):\n        ip = local_ip(); port = self.server.server_port\n        n  = RelayHandler.active_clients\n        ch = RelayHandler.current_url or \"— ninguno —\"\n        html = (\n            \"<!DOCTYPE html><html lang='es'><head><meta charset='utf-8'>\"\n            \"<meta http-equiv='refresh' content='3'>\"\n            \"<title>SLOCast</title>\"\n            \"<style>body{background:#0f0f0f;color:#e0e0e0;font-family:sans-serif;\"\n            \"text-align:center;padding:40px} h1{color:#FFB300}\"\n            \".url{background:#071407;color:#2ECC71;font-family:monospace;\"\n            \"padding:12px 20px;border-radius:6px;font-size:16px;display:inline-block;margin:16px 0}\"\n            \"a{color:#FFB300} p{color:#aaa;font-size:13px}</style></head><body>\"\n            f\"<h1>SLOCast Relay</h1>\"\n            f\"<p>{'Activo' if RelayHandler.current_url else 'Sin canal'} — {n} cliente(s)</p>\"\n            f\"<div class='url'>http://{ip}:{port}/stream</div>\"\n            f\"<p><a href='/stream'>Reproducir aqui mismo</a></p>\"\n            f\"<p style='color:#555;font-size:11px'>{ch[:80]}</p>\"\n            \"</body></html>\"\n        )\n        self.send_response(200)\n        self.send_header(\"Content-Type\", \"text/html; charset=utf-8\")\n        self.end_headers(); self.wfile.write(html.encode())\n\n    def _proxy(self, url: str):\n        with RelayHandler._lock: RelayHandler.active_clients += 1\n        try:\n            req = urllib.request.Request(url, headers={\"User-Agent\": UA, \"Accept\": \"*/*\"})\n            with urllib.request.urlopen(req, timeout=20) as resp:\n                ct   = resp.headers.get(\"Content-Type\", \"\")\n                data = resp.read(65536)\n                is_hls = (\"mpegurl\" in ct.lower()\n                          or url.split(\"?\")[0].endswith(\".m3u8\")\n                          or data.lstrip().startswith(b\"#EXTM3U\"))\n                if is_hls:\n                    data += resp.read()\n                    rewritten = self._rewrite_hls(data.decode(\"utf-8\", \"ignore\"), url)\n                    payload = rewritten.encode(\"utf-8\")\n                    self.send_response(200)\n                    self.send_header(\"Content-Type\", \"application/vnd.apple.mpegurl\")\n                    self.send_header(\"Content-Length\", str(len(payload)))\n                    self.send_header(\"Cache-Control\", \"no-cache\")\n                    self.send_header(\"Access-Control-Allow-Origin\", \"*\")\n                    self.end_headers(); self.wfile.write(payload)\n                else:\n                    self.send_response(200)\n                    self.send_header(\"Content-Type\", ct or \"video/mp2t\")\n                    self.send_header(\"Cache-Control\", \"no-cache\")\n                    self.send_header(\"Access-Control-Allow-Origin\", \"*\")\n                    self.end_headers(); self.wfile.write(data)\n                    while True:\n                        chunk = resp.read(65536)\n                        if not chunk: break\n                        self.wfile.write(chunk)\n        except (BrokenPipeError, ConnectionResetError):\n            pass\n        except Exception as e:\n            try: self.send_error(502, str(e))\n            except Exception: pass\n        finally:\n            with RelayHandler._lock: RelayHandler.active_clients -= 1\n\n    def _rewrite_hls(self, content: str, base_url: str) -> str:\n        ip = local_ip(); port = self.server.server_port\n        base = base_url.rsplit(\"/\", 1)[0] + \"/\"\n        lines = []\n        for line in content.splitlines():\n            s = line.strip()\n            if s and not s.startswith(\"#\"):\n                full = s if s.startswith(\"http\") else urllib.parse.urljoin(base, s)\n                enc  = urllib.parse.quote(full, safe=\"\")\n                line = f\"http://{ip}:{port}/proxy?url={enc}\"\n            lines.append(line)\n        return \"\\n\".join(lines)\n\n    def log_message(self, *_): pass\n\n\nclass RelayServer:\n    PORT = 8765\n    def __init__(self):\n        self._srv = None; self.running = False\n    def start(self):\n        if self.running: return True\n        try:\n            self._srv = ThreadingHTTPServer((\"0.0.0.0\", self.PORT), RelayHandler)\n            threading.Thread(target=self._srv.serve_forever, daemon=True).start()\n            self.running = True; return True\n        except OSError as e:\n            print(f\"[Relay] Puerto {self.PORT} ocupado: {e}\"); return False\n    def stop(self):\n        if self._srv: self._srv.shutdown(); self.running = False\n    def set(self, url: str): RelayHandler.current_url = url\n    def clear(self): RelayHandler.current_url = None\n    @property\n    def stream_url(self): return f\"http://{local_ip()}:{self.PORT}/stream\"\n\n# ──────────────────────────────────────────────────────────────\n#  HILO DE CARGA M3U\n# ──────────────────────────────────────────────────────────────\nclass M3ULoader(QThread):\n    loaded   = pyqtSignal(list)\n    failed   = pyqtSignal(str)\n    progress = pyqtSignal(str)\n\n    def __init__(self, source: str):\n        super().__init__(); self.source = source\n\n    def run(self):\n        try:\n            if self.source.startswith((\"http://\", \"https://\")):\n                self.progress.emit(\"Descargando lista...\")\n                req = urllib.request.Request(self.source, headers={\"User-Agent\": UA})\n                with urllib.request.urlopen(req, timeout=25) as r:\n                    content = r.read().decode(\"utf-8\", \"ignore\")\n            else:\n                self.progress.emit(\"Leyendo archivo...\")\n                content = Path(self.source).read_text(encoding=\"utf-8\", errors=\"ignore\")\n            self.progress.emit(\"Procesando...\")\n            self.loaded.emit(self._parse(content))\n        except Exception as e:\n            self.failed.emit(str(e))\n\n    @staticmethod\n    def _parse(txt: str) -> list:\n        channels, name, group = [], \"Canal\", \"\"\n        for line in txt.splitlines():\n            line = line.strip()\n            if line.startswith(\"#EXTINF:\"):\n                parts = line.split(\",\", 1)\n                name  = parts[1].strip() if len(parts) > 1 else \"Canal\"\n                group = \"\"\n                if 'group-title=\"' in line:\n                    try: group = line.split('group-title=\"')[1].split('\"')[0]\n                    except IndexError: pass\n            elif line and not line.startswith(\"#\"):\n                channels.append({\"name\": name, \"url\": line, \"group\": group})\n                name = \"Canal\"; group = \"\"\n        return channels\n\n# ──────────────────────────────────────────────────────────────\n#  BARRA DE CONTROLES\n# ──────────────────────────────────────────────────────────────\nclass Controls(QWidget):\n    def __init__(self, player, audio, parent=None):\n        super().__init__(parent)\n        self.player = player; self.audio = audio; self._muted = False\n        self.setFixedHeight(52)\n        self.setStyleSheet(\"background:#141414;border-top:1px solid #1E1E1E\")\n        lay = QHBoxLayout(self)\n        lay.setContentsMargins(12, 5, 12, 5); lay.setSpacing(6)\n\n        self.btn_play = QPushButton(\"▶ Play\"); self.btn_play.setObjectName(\"C\")\n        self.btn_stop = QPushButton(\"⏹\");     self.btn_stop.setObjectName(\"C\")\n        self.btn_stop.setFixedWidth(42)\n        self.dot = QLabel(\"●\"); self.dot.setStyleSheet(\"color:#444;font-size:20px\")\n        self.lbl = QLabel(\"Sin canal\")\n        self.lbl.setStyleSheet(\"color:#FFB300;font-weight:bold\")\n        self.lbl.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Preferred)\n        lbl_v = QLabel(\"🔊\"); lbl_v.setStyleSheet(\"color:#777\")\n        self.vol = QSlider(Qt.Orientation.Horizontal)\n        self.vol.setRange(0, 100); self.vol.setValue(80); self.vol.setFixedWidth(110)\n        self.btn_m = QPushButton(\"🔇\"); self.btn_m.setObjectName(\"C\"); self.btn_m.setFixedWidth(40)\n\n        for w in (self.btn_play, self.btn_stop, self.dot, self.lbl, lbl_v, self.vol, self.btn_m):\n            lay.addWidget(w)\n\n        if HAS_MULTIMEDIA and audio:\n            audio.setVolume(0.8)\n            self.btn_play.clicked.connect(self._play_pause)\n            self.btn_stop.clicked.connect(player.stop)\n            self.btn_m.clicked.connect(self._mute)\n            self.vol.valueChanged.connect(lambda v: audio.setVolume(v / 100))\n            player.playbackStateChanged.connect(self._state)\n            player.errorOccurred.connect(lambda e, m: (\n                self.dot.setStyleSheet(\"color:#E74C3C;font-size:20px\"),\n                self.lbl.setText(f\"Error: {m}\")\n            ))\n\n    def _play_pause(self):\n        ps = QMediaPlayer.PlaybackState\n        if self.player.playbackState() == ps.PlayingState: self.player.pause()\n        else: self.player.play()\n\n    def _mute(self):\n        self._muted = not self._muted\n        if self.audio: self.audio.setMuted(self._muted)\n        self.btn_m.setText(\"🔔\" if self._muted else \"🔇\")\n\n    def _state(self, s):\n        ps = QMediaPlayer.PlaybackState\n        if s == ps.PlayingState:\n            self.btn_play.setText(\"⏸ Pausa\")\n            self.dot.setStyleSheet(\"color:#2ECC71;font-size:20px\")\n        elif s == ps.PausedState:\n            self.btn_play.setText(\"▶ Play\")\n            self.dot.setStyleSheet(\"color:#FFB300;font-size:20px\")\n        else:\n            self.btn_play.setText(\"▶ Play\")\n            self.dot.setStyleSheet(\"color:#444;font-size:20px\")\n\n    def set_channel(self, name: str):\n        self.lbl.setText(f\"📺 {name}\")\n        self.dot.setStyleSheet(\"color:#3498DB;font-size:20px\")\n\n# ──────────────────────────────────────────────────────────────\n#  VENTANA PRINCIPAL\n# ──────────────────────────────────────────────────────────────\nclass SLOCast(QMainWindow):\n    def __init__(self):\n        super().__init__()\n        self.setWindowTitle(\"SLOCast v3.0 — IPTV & Multi-Screen\")\n        self.resize(1300, 800); self.setMinimumSize(900, 600)\n        self.setStyleSheet(DARK)\n        self.channels: list = []; self._loaders: list = []\n\n        self.relay = RelayServer()\n        self._relay_ok = self.relay.start()\n\n        if HAS_MULTIMEDIA:\n            self.player = QMediaPlayer()\n            self.audio  = QAudioOutput()\n            self.player.setAudioOutput(self.audio)\n            self.video  = QVideoWidget()\n            self.player.setVideoOutput(self.video)\n            self.video.setStyleSheet(\"background:#000\")\n        else:\n            self.video = QLabel(\n                \"Sin módulo multimedia.\\n\\n\"\n                \"sudo dnf install python3-pyqt6-qt6-multimedia gstreamer1-libav\"\n            )\n            self.video.setAlignment(Qt.AlignmentFlag.AlignCenter)\n\n        self._build()\n\n    # ── Layout ────────────────────────────────────────────────────\n    def _build(self):\n        root = QWidget(); self.setCentralWidget(root)\n        vl = QVBoxLayout(root); vl.setContentsMargins(0,0,0,0); vl.setSpacing(0)\n\n        body = QWidget(); hl = QHBoxLayout(body)\n        hl.setContentsMargins(0,0,0,0); hl.setSpacing(0)\n        hl.addWidget(self._sidebar())\n\n        self.pages = QStackedWidget()\n        self.pages.addWidget(self._p_browser())  # 0\n        self.pages.addWidget(self._p_iptv())      # 1\n        self.pages.addWidget(self._p_files())     # 2\n        self.pages.addWidget(self._p_cast())      # 3\n        hl.addWidget(self.pages, 1)\n        vl.addWidget(body, 1)\n\n        if HAS_MULTIMEDIA:\n            self.ctrl = Controls(self.player, self.audio)\n            vl.addWidget(self.ctrl)\n\n        ip   = local_ip(); port = RelayServer.PORT\n        info = (f\"Relay activo → http://{ip}:{port}/stream\"\n                if self._relay_ok else f\"Relay no pudo iniciarse (puerto {port} ocupado)\")\n        self.sb = QLabel(f\"  SLOCast v3.0  |  {info}\")\n        self.sb.setObjectName(\"SB\"); vl.addWidget(self.sb)\n\n        self.nav.idClicked.connect(self._nav)\n        self.btn_iptv.setChecked(True); self.pages.setCurrentIndex(1)\n\n    def _sidebar(self) -> QWidget:\n        sb = QWidget(); sb.setObjectName(\"Sidebar\")\n        vl = QVBoxLayout(sb); vl.setContentsMargins(0,0,0,0); vl.setSpacing(0)\n        brand = QLabel(\"👑 SLOCast\"); brand.setObjectName(\"Brand\"); vl.addWidget(brand)\n        sep = QFrame(); sep.setFrameShape(QFrame.Shape.HLine)\n        sep.setStyleSheet(\"color:#222\"); vl.addWidget(sep); vl.addSpacing(6)\n\n        self.btn_web   = QPushButton(\"🌐  Navegador Web\")\n        self.btn_iptv  = QPushButton(\"📺  IPTV / M3U\")\n        self.btn_files = QPushButton(\"📁  Archivos Locales\")\n        self.btn_cast  = QPushButton(\"📡  Transmitir a TV\")\n\n        self.nav = QButtonGroup(self); self.nav.setExclusive(True)\n        for i, b in enumerate([self.btn_web, self.btn_iptv, self.btn_files, self.btn_cast]):\n            b.setCheckable(True); vl.addWidget(b); self.nav.addButton(b, i)\n\n        vl.addStretch()\n        rl = QLabel(f\"🔗 Relay :{RelayServer.PORT}  {local_ip()}\")\n        rl.setStyleSheet(\"color:#2ECC71;font-size:11px;padding:8px 14px 14px 14px\")\n        vl.addWidget(rl); return sb\n\n    # ── Páginas ───────────────────────────────────────────────────\n    def _p_browser(self) -> QWidget:\n        w = QWidget(); vl = QVBoxLayout(w)\n        vl.setContentsMargins(0,0,0,0); vl.setSpacing(0)\n        if HAS_WEBENGINE:\n            bar = QWidget(); bar.setStyleSheet(\"background:#141414\")\n            hl  = QHBoxLayout(bar); hl.setContentsMargins(8,5,8,5)\n            self.web_url = QLineEdit()\n            self.web_url.setPlaceholderText(\"Escribe una URL y pulsa Enter…\")\n            self.web_url.returnPressed.connect(self._go)\n            btn = QPushButton(\"Ir\"); btn.setObjectName(\"A\"); btn.setFixedWidth(52)\n            btn.clicked.connect(self._go)\n            hl.addWidget(self.web_url); hl.addWidget(btn); vl.addWidget(bar)\n            self.web = QWebEngineView()\n            self.web.setUrl(QUrl(\"https://duckduckgo.com\")); vl.addWidget(self.web, 1)\n        else:\n            vl.addWidget(QLabel(\"WebEngine no disponible.\\n\"\n                                \"sudo dnf install python3-pyqt6-qt6-webengine\"),\n                         0, Qt.AlignmentFlag.AlignCenter)\n        return w\n\n    def _p_iptv(self) -> QWidget:\n        w = QWidget(); vl = QVBoxLayout(w)\n        vl.setContentsMargins(10,10,10,6); vl.setSpacing(8)\n\n        # Carga\n        top = QHBoxLayout()\n        self.m3u_in = QLineEdit()\n        self.m3u_in.setPlaceholderText(\"URL M3U (http://…) o ruta local (/home/…)\")\n        self.m3u_in.returnPressed.connect(self.load_m3u)\n        btn_f = QPushButton(\"📂\"); btn_f.setObjectName(\"C\"); btn_f.setFixedWidth(42)\n        btn_f.setToolTip(\"Abrir M3U local\"); btn_f.clicked.connect(self._open_m3u)\n        btn_l = QPushButton(\"⬇ Cargar\"); btn_l.setObjectName(\"A\"); btn_l.setFixedWidth(110)\n        btn_l.clicked.connect(self.load_m3u)\n        top.addWidget(self.m3u_in); top.addWidget(btn_f); top.addWidget(btn_l)\n        vl.addLayout(top)\n\n        # Búsqueda\n        sb2 = QHBoxLayout()\n        self.srch = QLineEdit(); self.srch.setPlaceholderText(\"🔍 Buscar canal o grupo…\")\n        self.srch.textChanged.connect(self._filter)\n        self.cnt = QLabel(\"0 canales\"); self.cnt.setStyleSheet(\"color:#555;font-size:12px\")\n        sb2.addWidget(self.srch); sb2.addWidget(self.cnt); vl.addLayout(sb2)\n\n        # Splitter\n        spl = QSplitter(Qt.Orientation.Horizontal)\n        self.ch_list = QListWidget()\n        self.ch_list.itemClicked.connect(self._ch_click)\n        self.ch_list.itemDoubleClicked.connect(self._ch_dbl)\n        spl.addWidget(self.ch_list); spl.addWidget(self.video); spl.setSizes([310, 900])\n        vl.addWidget(spl, 1)\n\n        self.prog = QLabel(\"\"); self.prog.setStyleSheet(\"color:#555;font-size:12px\")\n        vl.addWidget(self.prog); return w\n\n    def _p_files(self) -> QWidget:\n        w = QWidget(); vl = QVBoxLayout(w)\n        vl.setContentsMargins(24,24,24,24); vl.setSpacing(14)\n        ttl = QLabel(\"📁 Vídeo Local\"); ttl.setStyleSheet(\"font-size:18px;font-weight:bold;color:#FFB300\")\n        desc = QLabel(\"Abre un archivo local. Se reproducirá en la vista IPTV\\n\"\n                      \"y el relay lo enviará automáticamente a tu TV.\")\n        desc.setStyleSheet(\"color:#888;font-size:13px\")\n        btn = QPushButton(\"🎬  Seleccionar archivo…\"); btn.setObjectName(\"A\"); btn.setFixedWidth(260)\n        btn.clicked.connect(self._open_local)\n        self.lbl_f = QLabel(\"Ningún archivo abierto\"); self.lbl_f.setStyleSheet(\"color:#555;font-size:13px\")\n        self.lbl_f.setWordWrap(True)\n        for w2 in (ttl, desc, btn, self.lbl_f): vl.addWidget(w2)\n        vl.addStretch(); return w\n\n    def _p_cast(self) -> QWidget:\n        w = QWidget(); vl = QVBoxLayout(w)\n        vl.setContentsMargins(28,22,28,22); vl.setSpacing(14)\n        ttl = QLabel(\"📡 Transmitir a TV — Relay Multi-Dispositivo\")\n        ttl.setStyleSheet(\"font-size:18px;font-weight:bold;color:#FFB300\")\n        vl.addWidget(ttl)\n\n        # Caja relay\n        box = QWidget(); box.setObjectName(\"RelayBox\")\n        bl  = QVBoxLayout(box); bl.setContentsMargins(18,14,18,14)\n        bl.addWidget(QLabel(\"🟢 Servidor relay activo en tu red local\")\n                     .__class__(text=\"🟢 Servidor relay activo en tu red local\",\n                                styleSheet=\"font-weight:bold;color:#2ECC71;font-size:15px\"))\n\n        lbl_s = QLabel(\"Introduce esta URL en VLC / MX Player / navegador de tu TV:\")\n        lbl_s.setStyleSheet(\"color:#aaa;font-size:13px;margin-top:6px\")\n        bl.addWidget(lbl_s)\n\n        row = QHBoxLayout(); row.setSpacing(10)\n        self.relay_edit = QLineEdit(); self.relay_edit.setObjectName(\"RelayUrl\")\n        self.relay_edit.setReadOnly(True); self.relay_edit.setText(self.relay.stream_url)\n        btn_c = QPushButton(\"📋 Copiar URL\"); btn_c.setObjectName(\"G\"); btn_c.setFixedWidth(140)\n        btn_c.clicked.connect(self._copy)\n        row.addWidget(self.relay_edit); row.addWidget(btn_c); bl.addLayout(row)\n        vl.addWidget(box)\n\n        # Instrucciones\n        devs = [\n            (\"📺 Xiaomi TV / Android TV\",\n             \"1. Instala VLC desde Google Play en tu TV\\n\"\n             \"2. VLC → Red → pega la URL → ▶\\n\"\n             \"   O bien: MX Player → Abrir URL de red\"),\n            (\"🖥 Smart TV (Samsung / LG / Hisense)\",\n             \"1. Navegador integrado del TV\\n\"\n             \"2. Escribe la URL directamente\\n\"\n             \"   O usa la app IPTV de tu TV\"),\n            (\"📱 Móvil / Tablet\",\n             \"VLC, MX Player, IPTV Smarters → Fuente de red → pega la URL\"),\n            (\"💻 Otro PC con VLC\",\n             \"VLC → Medio → Abrir URL de red → pega → ▶\"),\n        ]\n        for dev, txt in devs:\n            b2 = QWidget()\n            b2.setStyleSheet(\"background:#141414;border-radius:6px;border:1px solid #1E1E1E\")\n            b2l = QVBoxLayout(b2); b2l.setContentsMargins(14,8,14,8)\n            ld = QLabel(dev); ld.setStyleSheet(\"font-weight:bold;color:#FFB300\")\n            lt = QLabel(txt); lt.setStyleSheet(\"color:#bbb;font-size:13px\")\n            b2l.addWidget(ld); b2l.addWidget(lt); vl.addWidget(b2)\n\n        self.lbl_cl = QLabel(\"Dispositivos conectados: 0\")\n        self.lbl_cl.setStyleSheet(\"color:#555;font-size:12px\")\n        vl.addWidget(self.lbl_cl)\n\n        t = QTimer(self); t.timeout.connect(self._upd_cl); t.start(2000)\n        vl.addStretch(); return w\n\n    # ── Slots ─────────────────────────────────────────────────────\n    def _nav(self, idx: int):\n        self.pages.setCurrentIndex(idx)\n        if idx == 3: self.relay_edit.setText(self.relay.stream_url)\n\n    def _go(self):\n        url = self.web_url.text().strip()\n        if not url: return\n        if not url.startswith((\"http://\",\"https://\")): url = \"https://\" + url\n        self.web.setUrl(QUrl(url))\n\n    def load_m3u(self):\n        url = self.m3u_in.text().strip()\n        if not url:\n            QMessageBox.information(self, \"SLOCast\", \"Introduce la URL o ruta de tu lista M3U.\")\n            return\n        self.prog.setText(\"⏳ Iniciando carga…\")\n        loader = M3ULoader(url)\n        loader.progress.connect(lambda m: self.prog.setText(f\"⏳ {m}\"))\n        loader.loaded.connect(self._loaded)\n        loader.failed.connect(self._load_err)\n        loader.start(); self._loaders.append(loader)\n\n    def _open_m3u(self):\n        p, _ = QFileDialog.getOpenFileName(\n            self, \"Abrir lista M3U\", \"\", \"Listas M3U (*.m3u *.m3u8);;Todos (*)\")\n        if p: self.m3u_in.setText(p); self.load_m3u()\n\n    def _loaded(self, chs: list):\n        self.channels = chs; n = len(chs)\n        self.prog.setText(f\"✅ {n} canales cargados\")\n        self.cnt.setText(f\"{n} canales\"); self._populate(chs)\n\n    def _load_err(self, err: str):\n        self.prog.setText(\"❌ Error al cargar\")\n        QMessageBox.warning(self, \"Error M3U\",\n            f\"No se pudo cargar la lista:\\n\\n{err}\\n\\n\"\n            \"Comprueba la URL o tu conexión.\")\n\n    def _populate(self, chs: list):\n        self.ch_list.clear()\n        for ch in chs:\n            pre  = f\"[{ch['group']}] \" if ch.get(\"group\") else \"\"\n            item = QListWidgetItem(f\"{pre}{ch['name']}\")\n            item.setData(Qt.ItemDataRole.UserRole, ch)\n            if ch.get(\"group\"): item.setToolTip(f\"Grupo: {ch['group']}\")\n            self.ch_list.addItem(item)\n\n    def _filter(self, txt: str):\n        if not txt: self._populate(self.channels); self.cnt.setText(f\"{len(self.channels)} canales\"); return\n        t  = txt.lower()\n        fl = [c for c in self.channels if t in c[\"name\"].lower() or t in c.get(\"group\",\"\").lower()]\n        self._populate(fl); self.cnt.setText(f\"{len(fl)} / {len(self.channels)}\")\n\n    def _ch_click(self, item: QListWidgetItem):\n        ch = item.data(Qt.ItemDataRole.UserRole)\n        if ch and hasattr(self, \"ctrl\"): self.ctrl.set_channel(ch[\"name\"])\n\n    def _ch_dbl(self, item: QListWidgetItem):\n        ch = item.data(Qt.ItemDataRole.UserRole)\n        if ch: self._play(ch[\"url\"], ch[\"name\"])\n\n    def _play(self, url: str, name: str = \"\"):\n        if not HAS_MULTIMEDIA:\n            QMessageBox.warning(self, \"Sin multimedia\",\n                \"Instala: sudo dnf install python3-pyqt6-qt6-multimedia gstreamer1-libav\"); return\n        self.pages.setCurrentIndex(1); self.btn_iptv.setChecked(True)\n        self.relay.set(url)\n        self.player.setSource(QUrl(url)); self.player.play()\n        if hasattr(self, \"ctrl\"): self.ctrl.set_channel(name)\n        self.sb.setText(f\"  ▶ {name}  |  Relay: {self.relay.stream_url}\")\n\n    def _open_local(self):\n        p, _ = QFileDialog.getOpenFileName(\n            self, \"Abrir vídeo\", \"\",\n            \"Vídeo (*.mp4 *.mkv *.avi *.mov *.ts *.m4v *.flv *.wmv *.m2ts);;Todos (*)\")\n        if p: self.lbl_f.setText(p); self._play(f\"file://{p}\", Path(p).name)\n\n    def _copy(self):\n        url = self.relay.stream_url\n        QApplication.clipboard().setText(url)\n        QMessageBox.information(self, \"Copiada\",\n            f\"URL copiada:\\n\\n{url}\\n\\nPégala en VLC o el navegador de tu TV.\")\n\n    def _upd_cl(self):\n        n = RelayHandler.active_clients\n        self.lbl_cl.setText(\n            f\"📱 {n} dispositivo(s) conectado(s)\" if n else \"Dispositivos conectados: 0\")\n\n    def closeEvent(self, event):\n        self.relay.stop(); super().closeEvent(event)\n\n\n# ──────────────────────────────────────────────────────────────\nif __name__ == \"__main__\":\n    app = QApplication(sys.argv)\n    app.setApplicationName(\"SLOCast\")\n    win = SLOCast()\n    win.show()\n    sys.exit(app.exec())\nPYEOF\necho \"EXIT:$?\"","Cwd":"/home/slone","WaitMsBeforeAsync":5000,"toolAction":"Writing slocast.py to disk","toolSummary":"Escribir slocast.py en disco"}}]}
