    gap: 12px;\n    }\n    .rem-btn {\n      background: #111116;\n      color: var(--fluor);\n      border: 1px solid #22222a;\n      border-radius: 12px;\n      padding: 14px 8px;\n      font-size: 13px;\n      font-weight: 800;\n      cursor: pointer;\n      transition: all 0.15s;\n    }\n    .rem-btn:active {\n      background: var(--fluor);\n      color: #000;\n      transform: scale(0.96);\n    }\n    .rem-btn.span-2 {\n      grid-column: span 2;\n    }\n    .rem-btn.main {\n      background: var(--fluor);\n      color: #000;\n      border: none;\n      font-size: 15px;\n    }\n    .rem-btn.audio {\n      border: 2px solid var(--fluor);\n      background: #15151c;\n      color: var(--fluor);\n    }\n    .rem-btn.cast {\n      background: var(--green);\n      color: #000;\n      border: none;\n      font-size: 14px;\n    }\n\n    /* Cart & Checkout Drawer */\n    .cart-drawer {\n      position: fixed;\n      top: 0;\n      right: -460px;\n      width: 100%;\n      max-width: 440px;\n      height: 100vh;\n      background: #0a0a0c;\n      border-left: 1px solid var(--border);\n      z-index: 2000;\n      padding: 28px 24px;\n      display: flex;\n      flex-direction: column;\n      transition: right 0.35s cubic-bezier(0.16, 1, 0.3, 1);\n      box-shadow: -20px 0 50px rgba(0,0,0,0.9);\n    }\n    .cart-drawer.open {\n      right: 0;\n    }\n    .cart-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      border-bottom: 1px solid var(--border);\n      padding-bottom: 16px;\n      margin-bottom: 18px;\n    }\n    .cart-items {\n      flex-grow: 1;\n      overflow-y: auto;\n    }\n    .cart-empty {\n      text-align: center;\n      color: var(--muted);\n      margin-top: 60px;\n      font-size: 14px;\n    }\n    .cart-item {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding: 12px 0;\n      border-bottom: 1px solid #191920;\n    }\n    .cart-total {\n      border-top: 1px solid var(--border);\n      padding-top: 18px;\n      margin-bottom: 16px;\n      display: flex;\n      justify-content: space-between;\n      font-size: 20px;\n      font-weight: 900;\n    }\n\n    /* Payment Gateways Selector */\n    .payment-methods {\n      display: flex;\n      flex-direction: column;\n      gap: 10px;\n      margin-bottom: 20px;\n    }\n    .pay-btn {\n      background: #14141a;\n      border: 1px solid #282834;\n      color: #fff;\n      padding: 12px;\n      border-radius: 10px;\n      font-weight: 800;\n      font-size: 13px;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      cursor: pointer;\n      transition: all 0.2s;\n    }\n    .pay-btn:hover {\n      border-color: var(--fluor);\n      background: #1c1c24;\n    }\n    .pay-btn.active {\n      border-color: var(--fluor);\n      background: #181820;\n      box-shadow: 0 0 10px var(--fluor-glow);\n    }\n\n    /* Footer */\n    footer {\n      background: #000000;\n      border-top: 1px solid var(--border);\n      padding: 60px 24px 30px;\n      color: var(--muted);\n      font-size: 13px;\n    }\n    .footer-grid {\n      max-width: 1200px;\n      margin: 0 auto;\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n      gap: 40px;\n      margin-bottom: 50px;\n    }\n    .footer-col h4 {\n      color: #fff;\n      font-size: 14px;\n      font-weight: 800;\n      margin-bottom: 16px;\n      text-transform: uppercase;\n      letter-spacing: 1px;\n    }\n    .footer-col ul {\n      list-style: none;\n    }\n    .footer-col li {\n      margin-bottom: 10px;\n    }\n    .footer-col a {\n      color: var(--muted);\n      text-decoration: none;\n      transition: color 0.2s;\n    }\n    .footer-col a:hover {\n      color: var(--fluor);\n    }\n    .footer-bottom {\n      max-width: 1200px;\n      margin: 0 auto;\n      border-top: 1px solid #141418;\n      padding-top: 24px;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      flex-wrap: wrap;\n      gap: 16px;\n    }\n  </style>\n</head>\n<body>\n\n  <!-- Top Ticker -->\n  <div class=\"top-bar\">\n    <span class=\"live\">SLONE OS v7.0 LIVE · BIOMETRIC SECURED ENCLAVE</span>\n    <span>DROP 01: SOVEREIGN GENESIS // PRE-ORDER OPEN</span>\n    <span>TOKYO · MILANO · BARCELONA · NEW YORK</span>\n  </div>\n\n  <!-- Header -->\n  <header>\n    <a href=\"#\" class=\"brand-logo\">\n      <img src=\"/assets/crown_icon.png\" alt=\"SLONE Crown\">\n      <div class=\"brand-title\">SLONE<span>™</span></div>\n    </a>\n    <nav>\n      <a href=\"#os\">SLONE OS</a>\n      <a href=\"#store\">Drop 01</a>\n      <a href=\"#hardware\">Hardware CNC</a>\n      <a href=\"#remote\">Mando TV</a>\n    </nav>\n    <div class=\"header-actions\">\n      <a href=\"#remote\" class=\"btn-pill\">📺 Xiaomi Cast</a>\n      <button class=\"btn-pill btn-cart\" onclick=\"toggleCart()\">\n        🛒 Cesta (<span id=\"cart-count\">0</span>)\n      </button>\n    </div>\n  </header>\n\n  <!-- Hero Section -->\n  <section class=\"hero\">\n    <div class=\"hero-badge\">Global Media, Hardware & Luxury Conglomerate</div>\n    <h1>The Crown Is Earned.<br><span class=\"glow\">Rule Your Stream.</span></h1>\n    <p>Del graffiti callejero al monopolio internacional. Transmisión satélite sin cortes, latencia cero, multi-audio en directo en catalán y streetwear de alta costura técnica.</p>\n    <div class=\"hero-cta\">\n      <a href=\"#os\" class=\"btn-primary\">Descubrir SLONE OS</a>\n      <a href=\"#store\" class=\"btn-secondary\">Explorar Colección Drop 01</a>\n    </div>\n\n    <!-- Flagship Visual -->\n    <div class=\"hero-image-wrap\">\n      <img src=\"/assets/store.jpg\" alt=\"SLONE Flagship Store Tokio\">\n      <div class=\"hero-image-overlay\">\n        <div>\n          <h3>Flagship Store Tokyo & New York</h3>\n          <p>La Corona de Neón Flúor iluminando el bulevar de compras de lujo</p>\n        </div>\n        <span class=\"hero-badge\" style=\"margin:0;\">Boutique Oficial</span>\n      </div>\n    </div>\n  </section>\n\n  <!-- Section: SLONE OS (Ecosystem) -->\n  <section class=\"container\" id=\"os\">\n    <div class=\"section-header\">\n      <div class=\"section-tag\">División 01 — Tecnología de Transmisión</div>\n      <h2>SLONE OS: El Monopolio del Salón</h2>\n      <p style=\"color:var(--muted); max-width:650px; margin: 12px auto 0;\">Superando a Kodi, VLC y TiviMate. La única plataforma con tolerancia a fallos Zero-Freeze, multi-audio en directo y autenticación biométrica.</p>\n    </div>\n\n    <div class=\"features-grid\">\n      <div class=\"feature-card\">\n        <div class=\"feature-icon\">⚡</div>\n        <h3>Zero-Freeze Core</h3>\n        <p>Inyección de tramas de sincronización MPEG-TS y reconexión en 150 ms. Tu señal jamás se congela durante el minuto 90 del Clásico o en la última curva de MotoGP.</p>\n      </div>\n\n      <div class=\"feature-card\">\n        <div class=\"feature-icon\">🎙️</div>\n        <h3>Instant Multi-Audio</h3>\n        <p>Conmuta con 1 clic entre la señal principal de TV, el audio en catalán (Català) en Movistar/DAZN y las narraciones de radio oficiales sincronizadas.</p>\n      </div>\n\n      <div class=\"feature-card\">\n        <div class=\"feature-icon\">⏱️</div>\n        <h3>Ultra-Low Latency</h3>\n        <p>Transmisión punto a punto sincronizada al mismo segundo que la emisión satélite original. Celebra los goles antes de que tus vecinos se enteren.</p>\n      </div>\n\n      <div class=\"feature-card\">\n        <div class=\"feature-icon\">🔒</div>\n        <h3>Enclave Biométrico</h3>\n        <p>Control de acceso exclusivo mediante el sensor de huella dactilar Synaptics del ThinkPad X390. Nadie puede abrir ni modificar tu sistema sin tu huella.</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- Section: The Store (Drop 01) -->\n  <section class=\"container\" id=\"store\" style=\"border-top: 1px solid var(--border);\">\n    <div class=\"section-header\">\n      <div class=\"section-tag\">División 02 — SLONE Atelier</div>\n      <h2>Drop 01: The Sovereign Genesis</h2>\n      <p style=\"color:var(--muted); max-width:650px; margin: 12px auto 0;\">Edición ultra-limitada de 500 unidades numeradas. Algodón pesado de grado militar, aluminio aeroespacial y chips NFC criptográficos.</p>\n    </div>\n\n    <div class=\"store-grid\">\n      <!-- Item 1: Hoodie -->\n      <div class=\"product-card\">\n        <div class=\"product-img\">\n          <img src=\"/assets/merch.jpg\" alt=\"SLONE Heavyweight Hoodie\">\n          <div class=\"product-tag\">LIMITED 200 PCS</div>\n        </div>\n        <div class=\"product-details\">\n          <div class=\"product-title\">The Sovereign Hoodie 500 GSM</div>\n          <div class=\"product-desc\">Algodón orgánico japonés cepillado de gramaje extremo. Corona bordada en hilo flúor de alta densidad y chip NFC en la manga derecha.</div>\n          <div class=