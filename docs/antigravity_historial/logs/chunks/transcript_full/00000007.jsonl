 }\n    .feature-card:hover {\n      transform: translateY(-4px);\n      border-color: var(--border-focus);\n      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6), 0 0 20px var(--fluor-glow);\n    }\n    .feature-card:hover::before {\n      background: var(--fluor);\n    }\n    .feature-icon {\n      font-size: 32px;\n      margin-bottom: 16px;\n      color: var(--fluor);\n    }\n    .feature-card h3 {\n      font-size: 19px;\n      font-weight: 800;\n      margin-bottom: 10px;\n    }\n    .feature-card p {\n      color: var(--muted);\n      font-size: 14px;\n      line-height: 1.6;\n    }\n\n    /* Store & Drop 01 Section */\n    .store-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n      gap: 28px;\n    }\n    .product-card {\n      background: var(--surface);\n      border: 1px solid var(--border);\n      border-radius: 16px;\n      overflow: hidden;\n      display: flex;\n      flex-direction: column;\n      transition: all 0.3s;\n    }\n    .product-card:hover {\n      border-color: var(--fluor);\n      box-shadow: 0 12px 40px rgba(0,0,0,0.8), 0 0 25px var(--fluor-glow);\n    }\n    .product-img {\n      width: 100%;\n      height: 320px;\n      background: #050505;\n      position: relative;\n      overflow: hidden;\n    }\n    .product-img img {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      transition: transform 0.5s;\n    }\n    .product-card:hover .product-img img {\n      transform: scale(1.04);\n    }\n    .product-tag {\n      position: absolute;\n      top: 14px;\n      left: 14px;\n      background: #000;\n      color: var(--fluor);\n      border: 1px solid var(--fluor);\n      padding: 4px 10px;\n      border-radius: 20px;\n      font-size: 10px;\n      font-weight: 900;\n      letter-spacing: 1px;\n    }\n    .product-details {\n      padding: 24px;\n      display: flex;\n      flex-direction: column;\n      flex-grow: 1;\n    }\n    .product-title {\n      font-size: 18px;\n      font-weight: 800;\n      margin-bottom: 6px;\n    }\n    .product-desc {\n      color: var(--muted);\n      font-size: 13px;\n      margin-bottom: 16px;\n      flex-grow: 1;\n    }\n    .size-selector {\n      display: flex;\n      gap: 8px;\n      margin-bottom: 18px;\n    }\n    .size-btn {\n      background: #141416;\n      border: 1px solid var(--border);\n      color: #aaa;\n      padding: 6px 12px;\n      border-radius: 6px;\n      font-size: 12px;\n      font-weight: 700;\n      cursor: pointer;\n    }\n    .size-btn.active, .size-btn:hover {\n      border-color: var(--fluor);\n      color: var(--fluor);\n    }\n    .product-footer {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      border-top: 1px solid var(--border);\n      padding-top: 16px;\n    }\n    .price {\n      font-size: 20px;\n      font-weight: 900;\n      color: #fff;\n    }\n    .btn-buy {\n      background: var(--fluor);\n      color: #000;\n      border: none;\n      padding: 10px 18px;\n      border-radius: 8px;\n      font-weight: 800;\n      font-size: 12px;\n      text-transform: uppercase;\n      letter-spacing: 1px;\n      cursor: pointer;\n      transition: background 0.2s;\n    }\n    .btn-buy:hover {\n      background: #ffffff;\n    }\n\n    /* Live Remote Controller Section */\n    .remote-section {\n      background: #060608;\n      border-top: 1px solid var(--border);\n      border-bottom: 1px solid var(--border);\n      padding: 80px 24px;\n    }\n    .remote-wrap {\n      max-width: 500px;\n      margin: 0 auto;\n      background: #000;\n      border: 2px solid var(--border);\n      border-radius: 24px;\n      padding: 28px 24px;\n      box-shadow: 0 0 50px rgba(0,0,0,0.9), 0 0 30px var(--fluor-glow);\n    }\n    .remote-header {\n      text-align: center;\n      margin-bottom: 20px;\n    }\n    .remote-header h3 {\n      font-size: 22px;\n      font-weight: 900;\n      color: var(--fluor);\n    }\n    .remote-channel-display {\n      background: #0a0a0d;\n      border: 1px solid #1f1f26;\n      border-radius: 12px;\n      padding: 14px;\n      text-align: center;\n      margin-bottom: 18px;\n    }\n    .remote-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 12px;\n    }\n    .rem-btn {\n      background: #111116;\n      color: var(--fluor);\n      border: 1px solid #22222a;\n      border-radius: 12px;\n      padding: 14px 8px;\n      font-size: 13px;\n      font-weight: 800;\n      cursor: pointer;\n      transition: all 0.15s;\n    }\n    .rem-btn:active {\n      background: var(--fluor);\n      color: #000;\n      transform: scale(0.96);\n    }\n    .rem-btn.span-2 {\n      grid-column: span 2;\n    }\n    .rem-btn.main {\n      background: var(--fluor);\n      color: #000;\n      border: none;\n      font-size: 15px;\n    }\n    .rem-btn.audio {\n      border: 2px solid var(--fluor);\n      background: #15151c;\n      color: var(--fluor);\n    }\n    .rem-btn.cast {\n      background: var(--green);\n      color: #000;\n      border: none;\n      font-size: 14px;\n    }\n\n    /* Cart Drawer */\n    .cart-drawer {\n      position: fixed;\n      top: 0;\n      right: -420px;\n      width: 100%;\n      max-width: 400px;\n      height: 100vh;\n      background: #0a0a0c;\n      border-left: 1px solid var(--border);\n      z-index: 2000;\n      padding: 30px 24px;\n      display: flex;\n      flex-direction: column;\n      transition: right 0.35s cubic-bezier(0.16, 1, 0.3, 1);\n      box-shadow: -20px 0 50px rgba(0,0,0,0.9);\n    }\n    .cart-drawer.open {\n      right: 0;\n    }\n    .cart-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      border-bottom: 1px solid var(--border);\n      padding-bottom: 16px;\n      margin-bottom: 20px;\n    }\n    .cart-items {\n      flex-grow: 1;\n      overflow-y: auto;\n    }\n    .cart-empty {\n      text-align: center;\n      color: var(--muted);\n      margin-top: 60px;\n      font-size: 14px;\n    }\n    .cart-item {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      padding: 12px 0;\n      border-bottom: 1px solid #191920;\n    }\n    .cart-total {\n      border-top: 1px solid var(--border);\n      padding-top: 20px;\n      margin-bottom: 20px;\n      display: flex;\n      justify-content: space-between;\n      font-size: 20px;\n      font-weight: 900;\n    }\n\n    /* Footer */\n    footer {\n      background: #000000;\n      border-top: 1px solid var(--border);\n      padding: 60px 24px 30px;\n      color: var(--muted);\n      font-size: 13px;\n    }\n    .footer-grid {\n      max-width: 1200px;\n      margin: 0 auto;\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n      gap: 40px;\n      margin-bottom: 50px;\n    }\n    .footer-col h4 {\n      color: #fff;\n      font-size: 14px;\n      font-weight: 800;\n      margin-bottom: 16px;\n      text-transform: uppercase;\n      letter-spacing: 1px;\n    }\n    .footer-col ul {\n      list-style: none;\n    }\n    .footer-col li {\n      margin-bottom: 10px;\n    }\n    .footer-col a {\n      color: var(--muted);\n      text-decoration: none;\n      transition: color 0.2s;\n    }\n    .footer-col a:hover {\n      color: var(--fluor);\n    }\n    .footer-bottom {\n      max-width: 1200px;\n      margin: 0 auto;\n      border-top: 1px solid #141418;\n      padding-top: 24px;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      flex-wrap: wrap;\n      gap: 16px;\n    }\n  </style>\n</head>\n<body>\n\n  <!-- Top Ticker -->\n  <div class=\"top-bar\">\n    <span class=\"live\">SLONE OS v7.0 ENGINE ACTIVE · ZERO-FREEZE OPERATIONAL</span>\n    <span>DROP 01: SOVEREIGN GENESIS // 500 UNITS GLOBALLY</span>\n    <span>PARIS · TOKYO · MILANO · BARCELONA</span>\n  </div>\n\n  <!-- Header -->\n  <header>\n    <a href=\"#\" class=\"brand-logo\">\n      <img src=\"/assets/crown_icon.png\" alt=\"SLONE Crown\">\n      <div class=\"brand-title\">SLONE<span>™</span></div>\n    </a>\n    <nav>\n      <a href=\"#os\">SLONE OS</a>\n      <a href=\"#store\">Drop 01</a>\n      <a href=\"#hardware\">Hardware</a>\n      <a href=\"#remote\">Mando TV</a>\n    </nav>\n    <div class=\"header-actions\">\n      <a href=\"#remote\" class=\"btn-pill\">📺 Mando Xiaomi</a>\n      <button class=\"btn-pill btn-cart\" onclick=\"toggleCart()\">\n        🛒 Cesta (<span id=\"cart-count\">0</span>)\n      </button>\n    </div>\n  </header>\n\n  <!-- Hero Section -->\n  <section class=\"hero\">\n    <div class=\"hero-badge\">Global Media & Luxury Conglomerate</div>\n    <h1>The Crown Is Earned.<br><span class=\"glow\">Rule Your Stream.</span></h1>\n    <p>Del graffiti callejero al monopolio de entretenimiento y moda de lujo. Transmisión satélite sin cortes, baja latencia absoluta y streetwear de alta costura técnica.</p>\n    <div class=\"hero-cta\">\n      <a href=\"#os\" class=\"btn-primary\">Descubrir SLONE OS</a>\n      <a href=\"#store\" class=\"btn-secondary\">Explorar Colección Drop 01</a>\n    </div>\n\n    <!-- Flagship Visual -->\n    <div class=\"hero-image-wrap\">\n      <img src=\"/assets/store.jpg\" alt=\"SLONE Flagship Store\">\n      <div class=\"hero-image-overlay\">\n        <div>\n          <h3>Flagship Store Tokyo & New York</h3>\n          <p>La Corona de Neón Flúor iluminando el corazón urbano</p>\n        </div>\n        <span class=\"hero-badge\" style=\"margin:0;\">Boutique Oficial</span>\n      </div>\n    </div>\n  </section>\n\n  <!-- Section: SLONE OS (Ecosystem) -->\n  <section class=\"container\" id=\"os\">\n    <div class=\"section-header\">\n      <div class=\"section-tag\">División 01 — Tecnología de Transmisión</div>\n      <h2>SLONE OS: El Monopolio del Salón</h2>\n      <p style=\"color:var(--muted); max-width:650px; margin: 12px auto 0;\">Diseñado para superar a Kodi, VLC y TiviMate. La única plataforma con tolerancia a fallos Zero-Freeze y multi-audio instantáneo.</p>\n    </div>\n\n    <div class=\"features-grid\">\n      <div class=\"feature-card\">\n        <div class=\"feature-icon\">⚡</div>\n        <h3>Zero-Freeze Core</h3>\n        <p>Inyección de tramas MPEG-TS de sincronización y reintento en 150 ms. Tu señal jamás se congela durante el minuto 90 del Clásico o en la última curva de MotoGP.</p>\n      </div>\n\n      <div class=\"feature-card\">\n        <div class=\"feature-icon\">🎙️</div>\n        <h3>Instant Multi-Audio</h3>\n        <p>Conmuta con 1 clic entre la señal principal de TV, el audio en catalán (Català) en Movistar/DAZN y las narraciones de radio oficiales sincronizadas sin cortes.</p>\n      </div>\n\n      <div class=\"feature-card\">\n        <div class=\"feature-icon\">⏱️</div>\n        <h3>Ultra-Low Latency</h3>\n        <p>Transmisión directa punto a punto sincronizada al mismo segundo exacto que la emisión satélite original. Celebra los goles antes que tus vecinos.</p>\n      </div>\n\n      <div class=\"feature-card\">\n        <div class=\"feature-icon\">📺</div>\n        <h3>1-Click Xiaomi Relay</h3>\n        <p>Detección inteligente de tu Smart TV Xiaomi (SLÖNE en 192.168.1.135). Proyecta y controla todo tu catálogo sin cables ni configuraciones complejas.</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- Section: The Store (Drop 01) -->\n  <section class=\"container\" id=\"store\" style=\"border-top: 1px solid var(--border);\">\n    <div class=\"section-header\">\n      <div class=\"section-tag\">División 02 — SLONE Atelier</div>\n      <h2>Drop 01: The Sovereign Genesis</h2>\n      <p style=\"color:var(--muted); max-width:650px; margin: 12px auto 0;\">Edición ultra-limitada de 500 unidades numeradas. Algodón pesado de grado militar, aluminio aeroespacial y chips NFC criptográficos.</p>\n    </div>\n\n    <div class=\"store-grid\">\n      <!-- Item 1: Hoodie -->\n      <div class=\"product-card\">\n        <div class=\"product-img\">\n          <img src=\"/assets/merch.jpg\" alt=\"SLONE Heavyweight Hoodie\">\n          <div class=\"product-tag\">LIMITED 200 PCS</div>\n        </div>\n        <div class=\"product-details\">\n          <div class=\"product-title\">The Sovereign Hoodie 500 GSM</div>\n          <div class=\"product-desc\">Algodón orgánico japonés cepillado de gramaje extremo. Corona bordada en hilo flúor de alta densidad y chip NFC en la manga derecha.</div>\n          <div class=\"size-selector\">\n            <button class=\"size-btn\" onclick=\"selectSize(this)\">S</button>\n            <button class=\"size-btn active\" onclick=\"selectSize(this)\">M</button>\n            <button class=\"size-btn\" onclick=\"selectSize(this)\">L</button>\n            <button class=\"size-btn\" onclick=\"selectSize(this)\">XL</button>\n          </div>\n          <div class=\"product-footer\">\n            <div class=\"price\">220,00 €</div>\n            <button class=\"btn-buy\" onclick=\"addToCart('The Sovereign Hoodie (500 GSM)', 220)\">Añadir a la Cesta</button>\n          </div>\n        </div>\n      </div>\n\n      <!-- Item 2: Snapback Cap -->\n      <div class=\"product-card\">\n        <div class=\"product-img\">\n          <img src=\"/assets/logo.jpg\" alt=\"SLONE Cap\">\n          <div class=\"product-tag\">LIMITED 150 PCS</div>\n        </div>\n        <div class=\"product-details\">\n          <div class=\"product-title\">The 3D Crown Curved Cap</div>\n          <div class=\"product-desc\">Perfil estructurado en sarga de lana negra. Corona angular de tres puntas en relieve de silicona termosellada en amarillo flúor VR46.</div>\n          <div class=\"size-selector\">\n            <button class=\"size-btn active\">Talla Única (Ajustable)</button>\n          </div>\n          <div class=\"product-footer\">\n            <div class=\"price\">65,00 €</div>\n            <button class=\"btn-buy\" onclick=\"addToCart('The 3D Crown Cap', 65)\">Añadir a la Cesta</button>\n          </div>\n        </div>\n      </div>\n\n      <!-- Item 3: Hardware Remote -->\n      <div class=\"product-card\" id=\"hardware\">\n        <div class=\"product-img\">\n          <img src=\"/assets/merch.jpg\" alt=\"SLONE Remote\">\n          <div class=\"product-tag\">HARDWARE LABS</div>\n        </div>\n        <div class=\"product-details\">\n          <div class=\"product-title\">SLONE Precision Remote CNC</div>\n          <div class=\"product-desc\">Chasis unibody fresado en aluminio aeroespacial anodizado. Pantalla micro-OLED, botón dedicado de cambio de audio y batería de 6 meses.</div>\n          <div class=\"size-selector\">\n            <button class=\"size-btn active\">Matte Obsidian</button>\n          </div>\n          <div class=\"product-footer\">\n            <div class=\"price\">169,00 €</div>\n            <button class=\"btn-buy\" onclick=\"addToCart('SLONE Precision Remote CNC', 169)\">Pre-ordenar</button>\n          </div>\n        </div>\n      </div>\n\n      <!-- Item 4: OS Lifetime -->\n      <div class=\"product-card\">\n        <div class=\"product-img\" style=\"display:flex; align-items:center; justify-content:center; background:#0d0d12;\">\n          <img src=\"/assets/crown_icon.png\" style=\"width:120px; height:120px; object-fit:contain;\" alt=\"SLONE Black Card\">\n          <div class=\"product-tag\">DIGITAL LICENSE</div>\n        </div>\n        <div class=\"product-details\">\n          <div class=\"product-title\">SLONE OS Black Card Edition</div>\n          <div class=\"product-desc\">Licencia vitalicia ilimitada de SLONE OS. Acceso prioritario a servidores de streaming sin compresión, multi-pantalla y soporte VIP 24/7.</div>\n          <div class=\"size-selector\">\n            <button class=\"size-btn active\">Lifetime License</button>\n          </div>\n          <div class=\"product-footer\">\n            <div class=\"price\">99,00 €</div>\n            <button class=\"btn-buy\" onclick=\"addToCart('SLONE OS Black Card License', 99)\">Adquirir</button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Section: Live TV Controller -->\n  <section class=\"remote-section\" id=\"remote\">\n    <div class=\"remote-wrap\">\n      <div class=\"remote-header\">\n        <img src=\"/assets/crown_icon.png\" style=\"width:28px; height:28px; margin-bottom:6px;\" alt=\"Crown\">\n        <h3>SLONE.OS REMOTE</h3>\n        <p style=\"color:var(--muted); font-size:12px;\">Control en Tiempo Real para Xiaomi TV (192.168.1.135)</p>\n      </div>\n\n      <div class=\"remote-channel-display\">\n        <div style=\"color:var(--muted); font-size:11px; text-transform:uppercase; letter-spacing:1px;\">Emisión Actual</div>\n        <div id=\"remote-live-ch\" style=\"color:var(--fluor); font-size:17px; font-weight:800; margin-top:4px;\">Sintonizando Canal...</div>\n      </div>\n\n      <div class=\"remote-grid\">\n        <button class=\"rem-btn main span-2\" onclick=\"sendRemoteCmd('toggle')\">⏯ Play / Pausar Emisión</button>\n        <button class=\"rem-btn audio span-2\" onclick=\"sendRemoteCmd('cycle_audio')\">🎙 Conmutar Audio (Català / Radio / TV)</button>\n        <button class=\"rem-btn\" onclick=\"sendRemoteCmd('prev')\">⏮ Canal Anterior</button>\n        <button class=\"rem-btn\" onclick=\"sendRemoteCmd('next')\">⏭ Canal Siguiente</button>\n        <button class=\"rem-btn\" onclick=\"sendRemoteCmd('vol_up')\">🔊 Volumen +</button>\n        <button class=\"rem-btn\" onclick=\"sendRemoteCmd('vol_down')\">🔉 Volumen -</button>\n        <button class=\"rem-btn\" onclick=\"sendRemoteCmd('mute')\">🔇 Silenciar</button>\n        <button class=\"rem-btn\" onclick=\"sendRemoteCmd('fullscreen')\">⛶ Pantalla Completa</button>\n        <button class=\"rem-btn cast span-2\" onclick=\"sendRemoteCmd('cast_tv')\">📺 Proyectar Directo a Xiaomi TV</button>\n      </div>\n      <div style=\"text-align:center; color:#555; font-size:11px; margin-top:16px;\">Conectado a ThinkPad X390 Hub (Puerto 8765)</div>\n    </div>\n  </section>\n\n  <!-- Cart Drawer -->\n  <div class=\"cart-drawer\" id=\"cart-drawer\">\n    <div class=\"cart-header\">\n      <h3 style=\"font-weight:900; letter-spacing:1px;\">TU CESTA DE COMPRA</h3>\n      <button onclick=\"toggleCart()\" style=\"background:none; border:none; color:#fff; font-size:20px; cursor:pointer;\">✕</button>\n    </div>\n    <div class=\"cart-items\" id=\"cart-items\">\n      <div class=\"cart-empty\">Tu cesta está vacía.<br>Selecciona una pieza del Drop 01.</div>\n    </div>\n    <div class=\"cart-total\">\n      <span>TOTAL:</span>\n      <span id=\"cart-total-price\" style=\"color:var(--fluor);\">0,00 €</span>\n    </div>\n    <button class=\"btn-primary\" style=\"width:100%; border-radius:12px;\" onclick=\"checkoutSim()\">Proceder al Pago Seguro</button>\n  </div>\n\n  <!-- Footer -->\n  <footer>\n    <div class=\"footer-grid\">\n      <div class=\"footer-col\">\n        <div class=\"brand-title\" style=\"margin-bottom:12px;\">SLONE<span>™</span></div>\n        <p style=\"font-size:12px; line-height:1.7;\">El conglomerado multinacional de medios, hardware y lujo nacido de la cultura urbana. Tokyo · Paris · New York · Barcelona.</p>\n      </div>\n      <div class=\"footer-col\">\n        <h4>Ecosistema</h4>\n        <ul>\n          <li><a href=\"#os\">SLONE OS Player</a></li>\n          <li><a href=\"#os\">Zero-Freeze Core</a></li>\n          <li><a href=\"#os\">Multi-Audio Català</a></li>\n          <li><a href=\"#remote\">Mando Xiaomi TV</a></li>\n        </ul>\n      </div>\n      <div class=\"footer-col\">\n        <h4>Atelier & Merch</h4>\n        <ul>\n          <li><a href=\"#store\">Drop 01 Genesis</a></li>\n          <li><a href=\"#store\">Sovereign Hoodie</a></li>\n          <li><a href=\"#store\">Crown Snapback</a></li>\n          <li><a href=\"#hardware\">CNC Remote</a></li>\n        </ul>\n      </div>\n      <div class=\"footer-col\">\n        <h4>Soporte & Privacidad</h4>\n        <ul>\n          <li><a href=\"#\">Verificación Criptográfica NFC</a></li>\n          <li><a href=\"#\">Garantía de Hardware</a></li>\n          <li><a href=\"#\">Términos de Servicio</a></li>\n          <li><a href=\"#\">Manifiesto de Marca</a></li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"footer-bottom\">\n      <div>© 2026 SLONE ENTERPRISES LLC. TODOS LOS DERECHOS RESERVADOS.</div>\n      <div style=\"color:var(--fluor); font-weight:800; letter-spacing:1px;\">RULE YOUR STREAM. RULE THE STREET.</div>\n    </div>\n  </footer>\n\n  <script>\n    let cart = [];\n\n    function selectSize(btn) {\n      const parent = btn.parentElement;\n      parent.querySelectorAll('.size-btn').forEach(b => b.classList.remove('active'));\n      btn.classList.add('active');\n    }\n\n    function toggleCart() {\n      document.getElementById('cart-drawer').classList.toggle('open');\n    }\n\n    function addToCart(title, price) {\n      cart.push({ title, price });\n      updateCartUI();\n      document.getElementById('cart-drawer').classList.add('open');\n    }\n\n    function updateCartUI() {\n      document.getElementById('cart-count').innerText = cart.length;\n      const list = document.getElementById('cart-items');\n      if (cart.length === 0) {\n        list.innerHTML = '<div class=\"cart-empty\">Tu cesta está vacía.<br>Selecciona una pieza del Drop 01.</div>';\n        document.getElementById('cart-total-price').innerText = '0,00 €';\n        return;\n      }\n      let html = '';\n      let sum = 0;\n      cart.forEach((item, idx) => {\n        sum += item.price;\n        html += `\n          <div class=\"cart-item\">\n            <div>\n              <div style=\"font-weight:700; font-size:14px;\">${item.title}</div>\n              <div style=\"color:var(--fluor); font-size:13px; font-weight:800;\">${item.price.toFixed(2)} €</div>\n            </div>\n            <button onclick=\"removeFromCart(${idx})\" style=\"background:none; border:none; color:#ff4444; font-size:16px; cursor:pointer;\">✕</button>\n          </div>\n        `;\n      });\n      list.innerHTML = html;\n      document.getElementById('cart-total-price').innerText = sum.toFixed(2) + ' €';\n    }\n\n    function removeFromCart(idx) {\n      cart.splice(idx, 1);\n      updateCartUI();\n    }\n\n    function checkoutSim() {\n      if (cart.length === 0) return alert('La cesta está vacía.');\n      alert('👑 SLONE CHECKOUT\\n\\nTu pedido de edición limitada Drop 01 ha sido reservado.\\nSerás redirigido a la pasarela de pago seguro.');\n      cart = [];\n      updateCartUI();\n      toggleCart();\n    }\n\n    function sendRemoteCmd(act) {\n      fetch('/api/cmd?action=' + act)\n        .then(r => r.json())\n        .then(d => {\n          if (d.channel) {\n            document.getElementById('remote-live-ch').innerText = d.channel;\n          }\n        })\n        .catch(err => {\n          console.log('Error enviando comando:', err);\n        });\n    }\n\n    // Polling canal\n    setInterval(() => {\n      fetch('/api/cmd?action=status')\n        .then(r => r.json())\n        .then(d => {\n          if (d.channel) {\n            document.getElementById('remote-live-ch').innerText = d.channel;\n          }\n        })\n        .catch(() => {});\n    }, 4000);\n  </script>\n</body>\n</html>\n","Description":"Portal Web Oficial para SLONE ENTERPRISES en HTML5/CSS3 con catálogo de drops de ropa, vitrina de hardware CNC, reproductor y mando de TV en vivo.","Overwrite":true,"TargetFile":"/home/slone/.gemini/antigravity/scratch/slocast/web_portal/index.html","toolAction":"Creando portal web oficial SLONE","toolSummary":"Escribir web oficial interactiva de SLONE"}}]}
