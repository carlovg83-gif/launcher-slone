# SLONE™ Sovereign License Server — variables de entorno (opcionales)
# Copia este archivo a .env o expórtalas en tu shell/servicio.

# Puerto del servidor de licencias (coincide con slone_control.json → webhook_puerto)
PORT=8766

# Token de administrador para el endpoint /api/license/issue
SLONE_ADMIN_TOKEN=cambia-este-token-por-uno-largo-y-aleatorio

# Secreto de firma de licencias. DEBE coincidir con la app (misma variable).
# Rótalo con 'make secrets'. Si se omite, se usa el valor por defecto histórico.
SLONE_LICENSE_SECRET=

# Secreto del webhook de pago (debe coincidir con la pasarela: Lemon Squeezy/Stripe).
# Recomendado: genera uno fuerte con 'make secrets' (→ config/secrets.env).
# Si se omite, se usa config/slone_control.json → pasarela_pagos.webhook_secret.
SLONE_WEBHOOK_SECRET=

# Modo producción: exige firma HMAC válida en los webhooks (recomendado: 1)
SLONE_PRODUCTION=0
